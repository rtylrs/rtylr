# API
VITE_API_URL=https://api.voxire.com/

# Runtime environment label used by observability.
VITE_APP_ENV=production

# Firebase is optional in local development and required in production
# when Firebase-backed auth or analytics are enabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Observability is consent-gated by the app. Leave blank to disable.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
