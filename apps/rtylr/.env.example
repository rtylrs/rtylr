# Reference for every `VITE_*` key the rtylr frontend apps read. This file
# documents the keys; it is not loaded by anything and copying it to the repo
# root does nothing.
#
# To set up local development, use `.env.local.example` instead:
#
#     cp .env.local.example apps/<name>/.env.local
#
# Env files are read from `apps/<name>/` only. Every app sets Vite's `root` to
# its own directory and none set `envDir`, so a `.env.local` at the repo root
# is never loaded.
#
# Rule: every `VITE_*` var here is inlined into the browser bundle.
# Never put a secret behind a VITE_ prefix - they're public by design.

# ---- API ---------------------------------------------------------------
# Point every app at the backend. Defaults to production when unset.
VITE_API_URL=http://localhost:9999/

# Environment name surfaces in Sentry + PostHog as the `environment`
# tag. Usually "development" / "preview" / "production".
VITE_APP_ENV=development

# ---- Observability ---------------------------------------------------
# Sentry - leave blank for local dev. Get the DSN from sentry.io;
# the frontend project is `rtylr-frontend`.
VITE_SENTRY_DSN=

# PostHog EU (Frankfurt). Region is locked in code, only the project
# key is an env var. Frontend events go straight to eu.i.posthog.com.
VITE_POSTHOG_KEY=

# ---- Feature-flag kill switches -------------------------------------
# These are the FALLBACKS for when PostHog is unreachable. Prod
# defaults are OFF until each app is finished and tested.
# 1 = enabled, anything else = disabled.
VITE_APP_RECRUIT_ENABLED=1
VITE_APP_ERP_ENABLED=0
VITE_APP_CRM_ENABLED=0
VITE_APP_FINANCE_ENABLED=0
VITE_APP_INSIGHTS_ENABLED=0
VITE_APP_MENU_ENABLED=0
VITE_APP_POS_ENABLED=0
