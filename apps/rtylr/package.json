{
  "name": "rtylr",
  "version": "0.0.0",
  "description": "Rtylr Multi-App Platform",
  "scripts": {
    "build": "./scripts/ensure-contracts.sh && pnpm typecheck && pnpm -C ../.. -r --filter '@rtylr/*' --filter dash --filter '!@rtylr/landing' --filter '!@rtylr/mcp' build",
    "dev": "pnpm -C ../.. -r --parallel --filter '@rtylr/*' --filter dash --filter '!@rtylr/landing' --filter '!@rtylr/mcp' dev",
    "test": "./scripts/test-with-file-check.sh",
    "test:watch": "./scripts/vitest.sh",
    "test:coverage": "./scripts/vitest.sh run --coverage",
    "test:e2e": "playwright test",
    "test:screenshots": "playwright test --grep @screenshots",
    "typecheck": "./scripts/ensure-contracts.sh && pnpm -C ../.. -r --filter '@rtylr/*' --filter dash --filter '!@rtylr/landing' --filter '!@rtylr/mcp' typecheck && pnpm -C ../.. -r --filter '@voxire/**' typecheck",
    "lint": "pnpm -C ../.. lint",
    "lint:fix": "pnpm -C ../.. lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:audit-requests": "./scripts/ensure-contracts.sh && node scripts/audit-request-contracts.mjs --fail-on-errors",
    "contracts:enforce": "node scripts/enforce-onekit-boundary.mjs --changed-only",
    "contracts:enforce:all": "node scripts/enforce-onekit-boundary.mjs --all",
    "test:rbac-evidence": "node scripts/validate-role-access-control-v2-evidence.mjs",
    "contracts:sync": "./scripts/ensure-contracts.sh && pnpm -C ../.. --filter @voxire/voxie typecheck",
    "docs:verify-citations": "node scripts/cross-app/verify-citations.mjs",
    "prepare": "husky",
    "init": "make -C ../../voxie generate"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@tanstack/react-query": "^5.99.2",
    "@voxire/components": "workspace:*",
    "@voxire/config": "workspace:*",
    "@voxire/observability": "workspace:*",
    "@voxire/utils": "workspace:*",
    "i18next": "^26.0.6",
    "neverthrow": "8.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "^17.0.4",
    "react-icons": "^5.6.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-loading-skeleton": "^3.5.0",
    "sonner": "^2.0.7",
    "tslib": "^2.8.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "i18next-resources-to-backend": "^1.2.1",
    "jiti": "2.6.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
