{
  "name": "rtylr",
  "version": "0.0.0",
  "description": "Rtylr Multi-App Platform",
  "scripts": {
    "build": "./scripts/ensure-contracts.sh && pnpm typecheck && pnpm -r --filter './apps/rtylr/apps/*' build",
    "dev": "pnpm -r --parallel --filter './apps/rtylr/apps/*' dev",
    "test": "./scripts/test-with-file-check.sh",
    "test:watch": "./scripts/vitest.sh",
    "test:coverage": "./scripts/vitest.sh run --coverage",
    "test:e2e": "playwright test",
    "test:screenshots": "playwright test --grep @screenshots",
    "typecheck": "./scripts/ensure-contracts.sh && pnpm -r --filter './apps/rtylr/apps/*' typecheck && pnpm -r --filter './packages/*' typecheck",
    "lint": "pnpm -C ../.. lint",
    "lint:fix": "pnpm -C ../.. lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:audit-requests": "./scripts/ensure-contracts.sh && node scripts/audit-request-contracts.mjs --fail-on-errors",
    "contracts:enforce": "node scripts/enforce-onekit-boundary.mjs --changed-only",
    "contracts:enforce:all": "node scripts/enforce-onekit-boundary.mjs --all",
    "test:rbac-evidence": "node scripts/validate-role-access-control-v2-evidence.mjs",
    "contracts:sync": "./scripts/ensure-contracts.sh && pnpm -C ../.. --filter @voxire/voxie typecheck",
    "docs:verify-citations": "node scripts/cross-app/verify-citations.mjs",
    "prepare": "husky",
    "init": "make -C ../../voxie generate"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@aldabil/react-scheduler": "^3.1.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@types/lodash": "^4.17.24",
    "@types/react-helmet": "^6.1.11",
    "@voxire/assets": "workspace:*",
    "@voxire/components": "workspace:*",
    "@voxire/config": "workspace:*",
    "@voxire/consent": "workspace:*",
    "@voxire/menu": "workspace:*",
    "@voxire/observability": "workspace:*",
    "@voxire/utils": "workspace:*",
    "axios": "^1.19.0",
    "chart.js": "^4.5.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.0.6",
    "lodash": "^4.18.1",
    "motion": "^12.38.0",
    "neverthrow": "8.2.0",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-cookie": "^8.1.0",
    "react-csv": "^2.2.2",
    "react-dom": "19.2.5",
    "react-dropzone": "^15.0.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.4",
    "react-icons": "^5.6.0",
    "react-icons-picker": "^1.0.9",
    "react-lazy-load-image-component": "^1.6.3",
    "react-loading-skeleton": "^3.5.0",
    "react-qrcode-logo": "^4.0.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.7",
    "tslib": "^2.8.1",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@playwright/test": "^1.59.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.30",
    "@swc/helpers": "~0.5.21",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "i18next-resources-to-backend": "^1.2.1",
    "jiti": "2.6.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.13.4",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
