{
  "name": "rtylr-landing-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @rtylr/landing dev",
    "build": "pnpm --filter @rtylr/landing build",
    "start": "pnpm --filter @rtylr/landing start",
    "typecheck": "pnpm --filter @rtylr/landing typecheck",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "serve": "^14.2.4"
  }
}