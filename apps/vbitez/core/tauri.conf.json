{
  "productName": "rtylr POS",
  "version": "0.1.0",
  "identifier": "com.rtylr.pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../dist/vbitez"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rtylr POS",
        "fullscreen": true,
        "resizable": true,
        "width": 1600,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
