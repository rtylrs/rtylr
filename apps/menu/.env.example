# Base URL for the Voxire API (used by the legacy menu flow)
VITE_API_URL=https://api.voxire.dev/

# Base URL for the POS public API (used by checkout + order-status).
# Defaults to VITE_API_URL when not set.
VITE_POS_API_URL=https://api.voxire.dev/

# Set to "true" to enable the online ordering cart and checkout flow
# on POS-backed menus (/b/:businessId). Feature is off by default.
VITE_ONLINE_ORDERING_ENABLED=false
