webhooks/deliveries":{"get":{"description":"Returns delivery attempts for the business's webhooks, most recent first.\n\nA registration whose endpoint has started failing is otherwise invisible\nto the tenant who owns it: deliveries retry, exhaust their attempts and\nare dead-lettered with nothing surfacing. Filter on status to find those.\n\nLiteral path segment rather than a parameter, so it does not collide with\nthe /webhooks/{id} routes above. Adding a GET /webhooks/{id} later would\nmake this ambiguous.","operationId":"DeveloperService_listWebhookDeliveries","parameters":[{"in":"query","name":"webhook_id","required":true,"schema":{"description":"webhook_id narrows to one registration. Omit for every registration in\nthe business.","format":"int64","type":"string"}},{"in":"query","name":"status","required":true,"schema":{"description":"status narrows to one status. \"dead\" is the one worth watching, since\nthose events will never arrive without intervention.","type":"string"}},{"in":"query","name":"page","required":true,"schema":{"format":"int32","type":"integer"}},{"in":"query","name":"limit","required":true,"schema":{"format":"int32","type":"integer"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/hub.developer.v1.ListWebhookDeliveriesResponse"}}},"description":"OK"}},"summary":"listWebhookDeliveries","tags":["DeveloperService"]}},"/hub/developer/v1/webhooks/{id}":{"delete":{"description":"Removes a webhook by ID.","operationId":"DeveloperService_deleteWebhook","parameters":[{"in":"path","name":"id","required":true,"schema":{"format":"int64","type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/hub.developer.v1.DeleteWebhookResponse"}}},"description":"OK"}},"summary":"deleteWebhook","tags":["DeveloperService"]},"put":{"description":"Updates an existing webhook.","operationId":"DeveloperService_updateWebhook","parameters":[{"in":"path","name":"id","required":tr