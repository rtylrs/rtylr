package hr.time_off.v1

/// TimeOffRequest is an employee's request for leave.
message TimeOffRequest {
  id: int64? @required @gt(0)
  owner_id: int64? @required @gt(0)
  staff_id: int64? @required @gt(0)
  type: string @required
  start_date: string @required
  end_date: string @required
  days_count: float64? @required @gt(0)
  /// The current lifecycle state.
  status: string @required
  reason: string @required
  approved_by: int64
  approved_at: string
  notes: string
  /// When the record was created.
  created_at: string
  /// When the record was last updated.
  updated_at: string
}

/// ApproveTimeOffRequestMsg carries an approval decision for a time-off request.
/// Not currently wired to any RPC in service.proto - kept for parity with the source proto.
message ApproveTimeOffRequestMsg {
  id: int64
  /// The current lifecycle state.
  status: string
  notes: string
}

/// ApproveTimeOffResponse is the result of an approval decision.
/// Not currently wired to any RPC in service.proto - kept for parity with the source proto.
message ApproveTimeOffResponse {
  success: bool
}

message ListTimeOffRequest {}

message ListTimeOffResponse {
  requests: TimeOffRequest[]
}

message SubmitTimeOffRequest {
  staff_id: int64? @required @gt(0)
  type: string @required
  start_date: string @required
  end_date: string @required
  days_count: float64? @required @gt(0)
  reason: string @required
  notes: string
}

message SubmitTimeOffResponse {
  id: int64
}
