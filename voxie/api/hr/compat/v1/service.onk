package hr.compat.v1

/// Compatibility contract for the profile projection used by Flow and HR.
service CompatibilityService {
  base_path: "/hr"


  getMyEmployee(EmptyRequest) -> JsonResponse @get("/employees/me")

  approveTimeOff(BodyRequest) -> JsonResponse @post("/time-off/approve") @body("body")

  getShifts(QueryRequest) -> JsonResponse @get("/shifts")
  getAvailability(QueryRequest) -> JsonResponse @get("/shifts/availability")
  upsertShift(BodyRequest) -> JsonResponse @post("/shifts") @body("body")
  setAvailability(BodyRequest) -> JsonResponse @post("/shifts/availability") @body("body")
  updateShift(BodyRequest) -> JsonResponse @put("/shifts") @body("body")
  getRoster(QueryRequest) -> JsonResponse @get("/shifts/roster")
  createShiftAssignment(BodyRequest) -> JsonResponse @post("/shifts/roster/assignments") @body("body")
  publishRoster(BodyRequest) -> JsonResponse @post("/shifts/roster/publish") @body("body")

  getTimesheets(QueryRequest) -> JsonResponse @get("/timesheets")
  getCurrentTimesheet(EmptyRequest) -> JsonResponse @get("/timesheets/current")
  getTimesheet(PathRequest) -> JsonResponse @get("/timesheets/{id}")
  submitTimesheet(PathBodyRequest) -> JsonResponse @post("/timesheets/{id}/submit") @body("body")
  approveTimesheet(PathBodyRequest) -> JsonResponse @post("/timesheets/{id}/approve") @body("body")
  rejectTimesheet(PathBodyRequest) -> JsonResponse @post("/timesheets/{id}/reject") @body("body")


  getDocuments(QueryRequest) -> JsonResponse @get("/documents")
  getExpiringDocuments(QueryRequest) -> JsonResponse @get("/documents/expiring")
  createDocument(BodyRequest) -> JsonResponse @post("/documents") @body("body")
  deleteDocument(PathRequest) -> JsonResponse @delete("/documents/{id}")



  getConfig(EmptyRequest) -> JsonResponse @get("/config")
  updateConfig(BodyRequest) -> JsonResponse @put("/config") @body("body")


  getEmployees(QueryRequest) -> JsonResponse @get("/employees")
  getEmployee(PathRequest) -> JsonResponse @get("/employees/{id}")
  createEmployee(BodyRequest) -> JsonResponse @post("/employees") @body("body")
  updateEmployee(PathBodyRequest) -> JsonResponse @put("/employees/{id}") @body("body")
  inviteEmployee(BodyRequest) -> JsonResponse @post("/employees/invite") @body("body")

  getAttendance(QueryRequest) -> JsonResponse @get("/attendance")
  updateEmployeePin(BodyRequest) -> JsonResponse @put("/employees/me/pin") @body("body")

  getRoles(EmptyRequest) -> JsonResponse @get("/roles")
  getPermissions(EmptyRequest) -> JsonResponse @get("/permissions")
  createRole(BodyRequest) -> JsonResponse @post("/roles") @body("body")
  updateRole(PathBodyRequest) -> JsonResponse @put("/roles/{id}") @body("body")


  getReviewCycle(PathRequest) -> JsonResponse @get("/performance/cycles/{id}")
  openReviewCycle(PathBodyRequest) -> JsonResponse @post("/performance/cycles/{id}/open") @body("body")
  createGoal(BodyRequest) -> JsonResponse @post("/performance/goals") @body("body")
  updateGoal(PathBodyRequest) -> JsonResponse @put("/performance/goals/{id}") @body("body")
  getPerformanceReviews(QueryRequest) -> JsonResponse @get("/performance/reviews")
  submitPerformanceReview(PathBodyRequest) -> JsonResponse @post("/performance/reviews/{id}/submit") @body("body")
  sharePerformanceReview(PathBodyRequest) -> JsonResponse @post("/performance/reviews/{id}/share") @body("body")

  getLeaveCalendar(QueryRequest) -> JsonResponse @get("/leave/calendar")
  createLocation(BodyRequest) -> JsonResponse @post("/locations") @body("body")

  getSetupStatus(EmptyRequest) -> JsonResponse @get("/setup/status")
  completeSetupStep(PathBodyRequest) -> JsonResponse @post("/setup/steps/{id}/complete") @body("body")

  getOvertimeConfig(EmptyRequest) -> JsonResponse @get("/overtime/config")
  updateOvertimeConfig(BodyRequest) -> JsonResponse @put("/overtime/config") @body("body")

  getPayrollConfig(EmptyRequest) -> JsonResponse @get("/payroll/config")
  updatePayrollConfig(BodyRequest) -> JsonResponse @put("/payroll/config") @body("body")
  getPayrollRuns(QueryRequest) -> JsonResponse @get("/payroll/runs")
  getPayrollRun(PathRequest) -> JsonResponse @get("/payroll/runs/{id}")
  getMyPayrollRuns(QueryRequest) -> JsonResponse @get("/payroll/my-runs")
  getMyPayrollRun(PathRequest) -> JsonResponse @get("/payroll/my-runs/{id}")
  triggerPayrollRun(BodyRequest) -> JsonResponse @post("/payroll/runs/trigger") @body("body")
  approvePayrollRun(PathBodyRequest) -> JsonResponse @post("/payroll/runs/{id}/approve") @body("body")

  getTimeEntries(QueryRequest) -> JsonResponse @get("/time-entries")
  createTimeEntry(BodyRequest) -> JsonResponse @post("/time-entries") @body("body")
  updateTimeEntry(PathBodyRequest) -> JsonResponse @put("/time-entries/{id}") @body("body")
  deleteTimeEntry(PathRequest) -> JsonResponse @delete("/time-entries/{id}")
  markTimeEntriesInvoiced(BodyRequest) -> JsonResponse @patch("/time-entries/mark-invoiced") @body("body")

  deleteEmployee(PathIdRequest) -> JsonResponse @delete("/employees/{id}")
  deleteShift(EmptyRequest) -> JsonResponse @delete("/shifts")
  deleteAvailability(EmptyRequest) -> JsonResponse @delete("/shifts/availability")
  getCompanyConfig(EmptyRequest) -> JsonResponse @get("/company-config")
  listCoreDepartments(EmptyRequest) -> JsonResponse @get("/core/departments")
  getDocument(PathIdRequest) -> JsonResponse @get("/documents/{id}")
  verifyEmployeeInvite(EmptyRequest) -> JsonResponse @get("/employees/invite/verify")
  listLocations(EmptyRequest) -> JsonResponse @get("/locations")
  getEmployeeChecklist(PathIdRequest) -> JsonResponse @get("/onboarding/checklists/{id}")
  getPerformanceConfig(EmptyRequest) -> JsonResponse @get("/performance/config")
  createCoreDepartment(BodyRequest) -> JsonResponse @post("/core/departments") @body("body")
  acceptEmployeeInvite(BodyRequest) -> JsonResponse @post("/employees/invite/accept") @body("body")
  assignEmployeeRole(PathIdBodyRequest) -> JsonResponse @post("/employees/{id}/role") @body("body")
  completeChecklistItem(PathIdBodyRequest) -> JsonResponse @post("/onboarding/checklists/items/{id}/complete") @body("body")
  exportPayrollRun(PathIdBodyRequest) -> JsonResponse @post("/payroll/runs/{id}/export") @body("body")
  updateCompanyConfig(BodyRequest) -> JsonResponse @put("/company-config") @body("body")
  updateCoreDepartment(PathIdBodyRequest) -> JsonResponse @put("/core/departments/{id}") @body("body")
  updateLocation(PathIdBodyRequest) -> JsonResponse @put("/locations/{id}") @body("body")
  updatePerformanceConfig(BodyRequest) -> JsonResponse @put("/performance/config") @body("body")
}
