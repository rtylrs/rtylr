package insights.dashboard.v1

message WorkloadEntry {
  /// user_id identifies the user associated with this request.
  user_id: int64
  /// open_tasks is the open tasks value for this contract.
  open_tasks: int64
  /// in_progress_tasks is the in progress tasks value for this contract.
  in_progress_tasks: int64
  /// completed_tasks is the completed tasks value for this contract.
  completed_tasks: int64
  /// overdue_tasks is the overdue tasks value for this contract.
  overdue_tasks: int64
  /// total_active is the total active value for this contract.
  total_active: int64
}

message RoadmapProject {
  /// project_id is the project id value for this contract.
  project_id: int64
  /// project_name is the project name value for this contract.
  project_name: string
  /// status is the current lifecycle state.
  status: string
  /// total_tasks is the total tasks value for this contract.
  total_tasks: int64
  /// completed_tasks is the completed tasks value for this contract.
  completed_tasks: int64
  /// progress_percent is the progress percent value for this contract.
  progress_percent: float64
  /// start_date is the start date value for this contract.
  start_date: string
  /// due_date is the due date value for this contract.
  due_date: string
}

message InsightsMetricCard {
  /// value is the headline metric value.
  value: int64
  /// delta_pct is the period-over-period change percentage.
  delta_pct: float64
}

message InsightsPctCard {
  /// value is the percentage metric value.
  value: float64
  /// delta_pct is the period-over-period change percentage.
  delta_pct: float64
}

message GetInsightsRequest {}

message GetInsightsResponse {
  /// total_tasks is the total tasks value for this contract.
  total_tasks: int64
  /// completed_tasks is the completed tasks value for this contract.
  completed_tasks: int64
  /// in_progress_tasks is the in progress tasks value for this contract.
  in_progress_tasks: int64
  /// overdue_tasks is the overdue tasks value for this contract.
  overdue_tasks: int64
  /// avg_cycle_time_days is the avg cycle time days value for this contract.
  avg_cycle_time_days: float64
  /// velocity is the velocity value for this contract.
  velocity: int64
  /// velocity_change is the velocity change value for this contract.
  velocity_change: int64
}

message GetRoadmapRequest {}

message GetRoadmapResponse {
  /// projects is the projects value for this contract.
  projects: RoadmapProject[]
}

message GetWorkloadRequest {}

message GetWorkloadResponse {
  /// workload is the workload value for this contract.
  workload: WorkloadEntry[]
}

message GetDashboardSummaryRequest {}

message GetDashboardSummaryResponse {
  /// revenue is MTD revenue in minor units with delta.
  revenue: InsightsMetricCard
  /// customers is MTD customer count with delta.
  customers: InsightsMetricCard
  /// orders is MTD order count with delta.
  orders: InsightsMetricCard
  /// margin is MTD margin percentage with delta.
  margin: InsightsPctCard
}

message GetSalesSummaryRequest {}

message GetSalesSummaryResponse {
  /// open_pipeline_value is the first-year value of every open CRM deal, in minor units.
  open_pipeline_value: int64
  /// open_deal_count is the number of open CRM deals.
  open_deal_count: int64
  /// won is the first-year value of deals won this month to date, in minor units, with the change against the same span last month.
  won: InsightsMetricCard
  /// recent_won_deal_count is the number of deals won since the start of last month.
  recent_won_deal_count: int64
  /// mrr is the monthly recurring revenue of signed CRM contracts active today, in minor units, with the change since the start of this month.
  mrr: InsightsMetricCard
  /// active_contract_count is the number of signed monthly and yearly CRM contracts that have started and not ended.
  active_contract_count: int64
}

message ProjectHours {
  /// project_id identifies a public Work project.
  project_id: int64
  /// project_name is the project's name.
  project_name: string
  /// minutes is the time logged on the project's tasks this month to date.
  minutes: int64
}

message GetHoursSummaryRequest {}

message GetHoursSummaryResponse {
  /// logged is the minutes logged in Work this month to date, with the change against the same span last month.
  logged: InsightsMetricCard
  /// prior_minutes is the minutes logged over the same span last month.
  prior_minutes: int64
  /// projects lists the public projects with time logged this month to date, most time first. Private projects count in logged but are not listed.
  projects: ProjectHours[]
}

message DashboardProject {
  /// project_id identifies the Work project.
  project_id: int64
  /// project_name is the project's name.
  project_name: string
  /// status is the project's lifecycle state: active, completed or archived.
  status: string
  /// visibility is public or private.
  visibility: string
}

message ListProjectsRequest {}

message ListProjectsResponse {
  /// projects lists the projects the caller may open, by name. Archived projects and personal My Tasks projects are left out.
  projects: DashboardProject[]
}

message GetProjectDashboardRequest {
  /// project_id identifies the Work project.
  project_id: int64 @gt(0)
}

message ProjectProgress {
  /// total_tasks counts the project's top-level tasks that are not archived.
  total_tasks: int64
  /// completed_tasks counts the top-level tasks that are done.
  completed_tasks: int64
  /// percent is completed_tasks as a share of total_tasks, from 0 to 100.
  percent: float64
}

message OverdueTask {
  /// task_id identifies the task.
  task_id: int64
  /// title is the task's title.
  title: string
  /// due_date is the task's due date as YYYY-MM-DD.
  due_date: string
  /// assignee_id identifies the person the task is assigned to; absent when it is unassigned.
  assignee_id: int64?
  /// assignee_name is the assignee's display name, as Work's task list shows it; absent when the task is unassigned or the name is unknown.
  assignee_name: string?
}

message ProjectHoursLogged {
  /// this_month is the minutes logged on the project's tasks this month to date, with the change against the same span last month.
  this_month: InsightsMetricCard
  /// prior_minutes is the minutes logged over the same span last month.
  prior_minutes: int64
  /// all_time_minutes is every minute logged on the project's tasks.
  all_time_minutes: int64
}

message ProjectInvoices {
  /// invoice_count counts the project's invoices that are not drafts, cancelled or void.
  invoice_count: int64
  /// invoiced is the total of those invoices, in minor units.
  invoiced: int64
  /// paid is the amount paid against those invoices, in minor units.
  paid: int64
  /// outstanding is the amount still due on sent, viewed, partially paid and overdue invoices, in minor units.
  outstanding: int64
  /// overdue is the amount still due on invoices that are marked overdue or past their due date, in minor units.
  overdue: int64
  /// overdue_count counts those overdue invoices.
  overdue_count: int64
}

message GetProjectDashboardResponse {
  /// project is the project the dashboard describes.
  project: DashboardProject
  /// progress is the project's task completion.
  progress: ProjectProgress
  /// overdue_task_count counts the project's open tasks past their due date.
  overdue_task_count: int64
  /// overdue_tasks lists up to five of those tasks, oldest due date first.
  overdue_tasks: OverdueTask[]
  /// hours is the time logged on the project's tasks.
  hours: ProjectHoursLogged
  /// invoices totals the invoices tagged with this project. Absent when the caller may not view finance invoices.
  invoices: ProjectInvoices?
}
