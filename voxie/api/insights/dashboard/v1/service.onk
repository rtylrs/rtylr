package insights.dashboard.v1

/// DashboardService defines insights dashboard endpoints.
service DashboardService {
  /// Returns high-level insights summary.
  getInsights(GetInsightsRequest) -> GetInsightsResponse @get("/insights")

  /// Returns the product roadmap view.
  getRoadmap(GetRoadmapRequest) -> GetRoadmapResponse @get("/roadmap")

  /// Returns team workload metrics.
  getWorkload(GetWorkloadRequest) -> GetWorkloadResponse @get("/workload")

  /// Returns MTD headline KPI cards for the insights home dashboard.
  getDashboardSummary(GetDashboardSummaryRequest) -> GetDashboardSummaryResponse @get("/summary")

  /// Returns CRM open pipeline, month-to-date won deal value and recurring revenue for the insights home dashboard.
  getSalesSummary(GetSalesSummaryRequest) -> GetSalesSummaryResponse @get("/sales")

  /// Returns the hours logged in Work this month to date, in total and per public project, for the insights home dashboard.
  getHoursSummary(GetHoursSummaryRequest) -> GetHoursSummaryResponse @get("/hours")

  /// Lists the Work projects the caller may open a project dashboard for: every public project and the private projects they are a member of.
  listProjects(ListProjectsRequest) -> ListProjectsResponse @get("/projects")

  /// Returns one Work project's dashboard: task progress, overdue tasks, hours logged and, for callers who may view finance invoices, the project's invoice totals. A private project the caller is not a member of is reported as not found.
  getProjectDashboard(GetProjectDashboardRequest) -> GetProjectDashboardResponse @get("/projects/{project_id}")
}
