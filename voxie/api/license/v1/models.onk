package license.v1

/// LicenseState is the public, secret-free status used by admin notices.
message LicenseState {
  mode: string
  valid: bool
  status: string
  reason: string? @nullable
  expires_at: string? @nullable
  grace_until: string? @nullable
  checked_at: string? @nullable
}

message GetLicenseStateRequest {}

message GetLicenseStateResponse {
  state: LicenseState @unwrap
}
