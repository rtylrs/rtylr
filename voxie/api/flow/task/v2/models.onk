}

message AddTaskDependencyBody {
  /// depends_on_task_id is the task this task is blocked by.
  depends_on_task_id: int64 @required @gt(0)
}

message AddTaskDependencyRequest {
  /// task_id is the task gaining the dependency.
  task_id: int64 @required @gt(0)
