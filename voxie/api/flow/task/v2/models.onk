message RemoveTaskDependencyRequest {
  /// task_id is the task losing the dependency.
  task_id: int64 @required @gt(0)
  /// depends_on_task_id is the dependency being removed.
  depends_on_task_id: int64 @required @gt(0)
}

message RemoveTaskDependencyResponse {
