package flow.view.v2

/// View is a saved filter/sort preset. Business-shared in v2: every member of
/// the caller's business can list and use saved views, matching v1's
/// workspace-sharing semantics. A per-view visibility toggle is reserved for a
/// later additive change.
message View {
  id: int64
  name: string
  icon: string
  /// JSON-encoded filter criteria for this saved view.
  filters: string
  group_by: string
  sort_by: string
  sort_dir: string
}

message ListViewsRequest {
  /// The current result page.
  page: int32 @query("page")
  /// The maximum number of records to return.
  limit: int32 @query("limit")
}

message ListViewsResponse {
  views: View[]
  pagination: PaginationResponse
}

message CreateViewRequest {
  name: string @required
  icon: string
  /// JSON-encoded filter criteria for this saved view.
  filters: string
  group_by: string
  sort_by: string
  sort_dir: string
}

message CreateViewResponse {
  view: View
}

message UpdateViewRequest {
  id: int64 @required @gt(0)
  name: string
  icon: string
  /// JSON-encoded filter criteria for this saved view.
  filters: string
  group_by: string
  sort_by: string
  sort_dir: string
}

message UpdateViewResponse {}

message DeleteViewRequest {
  id: int64 @required @gt(0)
}

message DeleteViewResponse {}
