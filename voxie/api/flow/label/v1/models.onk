package flow.label.v1

message Label {
  /// id is the unique identifier for the resource.
  id: int64
  /// workspace_id is the workspace id value for this contract.
  workspace_id: int64
  /// name is the name value for this contract.
  name: string
  /// color is the color value for this contract.
  color: string
  /// created_at is when the record was created.
  created_at: string
}

message ListLabelsRequest {
  /// workspace_id is the workspace id value for this contract.
  workspace_id: int64 @query("workspace_id")
  /// The current result page.
  page: int32 @query("page")
  /// The maximum number of records to return.
  limit: int32 @query("limit")
  /// The field to sort results by.
  sort_by: string @query("sort_by")
  /// The sort direction ("asc" or "desc").
  sort_dir: string @query("sort_dir")
}

message ListLabelsResponse {
  /// labels is the labels value for this contract.
  labels: Label[]
  pagination: PaginationResponse
}

message CreateLabelRequest {
  /// workspace_id is the workspace id value for this contract.
  workspace_id: int64? @required @gt(0)
  /// name is the name value for this contract.
  name: string @required
  /// color is the color value for this contract.
  color: string @required
}

message CreateLabelResponse {
  /// label is the label value for this contract.
  label: Label
}

message UpdateLabelRequest {
  /// id is the label identifier.
  id: int64 @gt(0)
  /// name is the label name.
  name: string @required
  /// color is the label color.
  color: string @required
}

message UpdateLabelResponse {
  /// message is a human-readable result message.
  message: string
}

message DeleteLabelRequest {
  /// id is the label identifier.
  id: int64 @gt(0)
}

message DeleteLabelResponse {
  /// message is a human-readable result message.
  message: string
}

message SetTaskLabelsRequest {
  task_id: int64? @required @gt(0)
  label_ids: int64[]
}

message SetTaskLabelsResponse {
  message: string
}
