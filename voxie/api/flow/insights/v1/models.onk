package flow.insights.v1

message VelocityPoint {
  cycle: string
  completed: int32
  total: int32
  completion_rate: float64
}

message BurndownPoint {
  day: int32
  ideal: float64
  actual: float64
}

message MemberTime {
  id: string
  name: string
  hours: float64
}

message ThroughputPoint {
  week: string
  completed: int32
}

message TeamTaskSummary {
  id: string
  title: string
  status: string
  priority: string
  due_date: string
}

message TeamMemberWorkload {
  id: string
  name: string
  initials: string
  capacity: int32
  assigned_hours: float64
  load: float64
  tasks: TeamTaskSummary[]
}

message RoadmapProject {
  id: string
  name: string
  color: string
  start_date: string
  target_date: string
  progress: int32
  done_count: int32
  task_count: int32
  description: string
  workspace_id: string
}

message GetInsightsRequest {
  workspace_id: string @query("workspace_id")
}

message GetInsightsResponse {
  velocity: VelocityPoint[]
  burndown: BurndownPoint[]
  cycle_time: float64
  time_by_member: MemberTime[]
  throughput: ThroughputPoint[]
  total_tasks: int32
  done_tasks: int32
}

message GetTeamWorkloadRequest {
  workspace_id: string @query("workspace_id")
}

message GetTeamWorkloadResponse {
  members: TeamMemberWorkload[]
}

message GetRoadmapRequest {
  workspace_id: string @query("workspace_id")
}

message GetRoadmapResponse {
  projects: RoadmapProject[]
}
