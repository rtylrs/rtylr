package flow.milestone.v1

message MilestoneProject {
  name: string
  color: string
}

message Milestone {
  id: int64
  project_id: int64
  name: string
  target_date: string
  progress: int32
  computed_progress: int32
  done_count: int32
  task_count: int32
  status: string
  description: string
  project: MilestoneProject
}

message ListMilestonesRequest {
  project_id: string @query("project_id")
  workspace_id: string @query("workspace_id")
}

message ListMilestonesResponse {
  milestones: Milestone[]
}

message CreateMilestoneRequest {
  project_id: int64
  workspace_id: int64
  name: string @required
  description: string
  target_date: string
}

message CreateMilestoneResponse {
  milestone: Milestone
}

message UpdateMilestoneRequest {
  id: int64
  name: string
  description: string
  status: string
  target_date: string
}

message UpdateMilestoneResponse {}
