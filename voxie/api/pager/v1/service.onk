package pager.v1

/// The order pager: a customer scans the venue's poster, enters the number on
/// the receipt and is rung when the staff mark that number ready. A venue is
/// an ordinary business.
service PagerService {
  // Public routes are anonymous. Budgets are per client and per concrete
  // path, so each venue and each ticket has its own.

  /// Returns the venue behind a pager link.
  getPublicVenue(GetPublicVenueRequest) -> GetPublicVenueResponse @get("/public/venues/{slug}") @meta("rate_limit", "60/m")

  /// Follows the ticket with this number, creating it unless the venue is strict.
  joinTicket(JoinTicketRequest) -> JoinTicketResponse @post("/public/venues/{slug}/join") @meta("rate_limit", "30/m")

  /// Returns the ticket a phone is following. Polled every few seconds.
  getPublicTicket(GetPublicTicketRequest) -> GetPublicTicketResponse @get("/public/tickets/{public_token}") @meta("rate_limit", "120/m")

  /// Silences the bell on every phone following the ticket. The status is unchanged.
  acknowledgeTicket(AcknowledgeTicketRequest) -> AcknowledgeTicketResponse @post("/public/tickets/{public_token}/acknowledge") @meta("rate_limit", "30/m")

  // Staff routes act on the signed-in caller's business.

  /// Lists the open tickets, oldest first.
  listTickets(ListTicketsRequest) -> ListTicketsResponse @get("/tickets")

  /// Enters a number. Returns the existing ticket when the number is already open.
  createTicket(CreateTicketRequest) -> CreateTicketResponse @post("/tickets")

  /// Marks a waiting ticket ready, which rings the phones following it.
  markReady(MarkReadyRequest) -> MarkReadyResponse @post("/tickets/{id}/ready")

  /// Rings the phones of a ready ticket again.
  remindTicket(RemindTicketRequest) -> RemindTicketResponse @post("/tickets/{id}/remind")

  /// Puts a ready ticket back to waiting.
  undoReady(UndoReadyRequest) -> UndoReadyResponse @post("/tickets/{id}/undo")

  /// Closes a ticket as collected and frees its number.
  collectTicket(CollectTicketRequest) -> CollectTicketResponse @post("/tickets/{id}/collect")

  /// Returns the business's pager settings.
  getSettings(GetSettingsRequest) -> GetSettingsResponse @get("/settings")

  /// Updates the business's pager settings.
  updateSettings(UpdateSettingsRequest) -> UpdateSettingsResponse @put("/settings")
}
