package support.settings.v1

message SupportSettings {
  id: int64
  business_id: int64
  auto_assign: bool
  sla_hours: int32
  business_hours: string
  notification_email: string
  created_at: string
  updated_at: string
}

message GetSupportSettingsRequest {}

message GetSupportSettingsResponse {
  settings: SupportSettings
}

message UpdateSupportSettingsRequest {
  auto_assign: bool
  sla_hours: int32 @required @gt(0) @lte(1000)
  business_hours: string
  notification_email: string
}

message UpdateSupportSettingsResponse {
  message: string
}
