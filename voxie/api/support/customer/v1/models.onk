package support.customer.v1

message SupportCustomer {
  id: int64
  business_id: int64
  name: string
  email: string
  phone: string
  total_tickets: int32
  last_ticket_at: string
  created_at: string
}

message ListSupportCustomersRequest {
  page: int32 @query("page")
  page_size: int32 @query("page_size")
}

message ListSupportCustomersResponse {
  customers: SupportCustomer[]
  total: int32
  page: int32
  page_size: int32
}

message GetSupportCustomerRequest {
  id: int64 @required @gt(0)
}

message GetSupportCustomerResponse {
  customer: SupportCustomer
}
