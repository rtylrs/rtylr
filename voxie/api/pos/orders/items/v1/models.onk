package pos.orders.items.v1

// ── Update Order Item Status ──────────────────────────────────────

message UpdateOrderItemStatusBody {
  /// status is the current lifecycle state.
  status: string @required
}

message UpdateOrderItemStatusRequest {
  order_id: int64 @gt(0)
  item_id: int64 @gt(0)
  /// body carries the new order item status bound from the HTTP payload.
  body: UpdateOrderItemStatusBody
}

message UpdateOrderItemStatusResponse {
  message: string
}

// ── Void Order Item ───────────────────────────────────────────────

message VoidOrderItemRequest {
  order_id: int64 @gt(0)
  item_id: int64 @gt(0)
}

message VoidOrderItemResponse {
  success: bool
}
