package pos.orders.holds.v1

// ── Hold Order ────────────────────────────────────────────────────

message HoldOrderRequest {
  order_id: int64 @gt(0)
  reason: string @required
}

message HoldOrderResponse {
  message: string
}

// ── List Held Orders ──────────────────────────────────────────────

message ListHeldOrdersRequest {}

message ListHeldOrdersResponse {
  orders: Order[]
}
