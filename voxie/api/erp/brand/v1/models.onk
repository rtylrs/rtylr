package erp.brand.v1

message Brand {
  id: int64
  owner_id: int64
  name: string
  logo_url: string
  description: string
  product_count: int64
  created_at: string
  updated_at: string
}

message CreateBrandRequest {
  name: string @required
  logo_url: string
  description: string
}

message CreateBrandResponse {
  brand_id: int64
  message: string
}

message UpdateBrandRequest {
  id: int64 @required @gt(0)
  name: string @required
  logo_url: string
  description: string
}

message UpdateBrandResponse {
  message: string
}

message DeleteBrandRequest {
  id: int64 @required @gt(0)
}

message DeleteBrandResponse {
  message: string
}

message ListBrandsRequest {}

message ListBrandsResponse {
  brands: Brand[]
}
