package erp.brand.v1

service BrandService {
  listBrands(ListBrandsRequest) -> ListBrandsResponse @get("/brands")

  createBrand(CreateBrandRequest) -> CreateBrandResponse @post("/brands")

  updateBrand(UpdateBrandRequest) -> UpdateBrandResponse @put("/brands/{id}")

  deleteBrand(DeleteBrandRequest) -> DeleteBrandResponse @delete("/brands/{id}")
}
