package erp.price_list.v1

message PriceList {
  id: int64
  owner_id: int64
  name: string
  currency: string
  is_default: bool
  created_at: string
  updated_at: string
}

message CreatePriceListRequest {
  name: string @required
  currency: string
  is_default: bool
}

message CreatePriceListResponse {
  price_list_id: int64
  message: string
}

message ListPriceListsRequest {}

message ListPriceListsResponse {
  price_lists: PriceList[]
}
