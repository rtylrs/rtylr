package finance.bill.v1

/// Bill is an accounts-payable bill owed to a supplier.
message Bill {
  /// id is the unique identifier for the resource.
  id: int64
  /// owner_id identifies the tenant that owns the resource.
  owner_id: int64
  /// supplier_id is the supplier id value for this contract.
  supplier_id: int64
  /// amount is the amount value for this contract.
  amount: float64
  /// currency is the currency value for this contract.
  currency: string
  /// due_date is the due date value for this contract.
  due_date: string
  /// status is the current lifecycle state.
  status: string
  /// description is the description value for this contract.
  description: string
  /// created_at is when the record was created.
  created_at: string
  /// updated_at is when the record was last updated.
  updated_at: string
}

message CreateBillRequest {
  /// supplier_id is the supplier id value for this contract.
  supplier_id: int64 @required @gt(0)
  /// amount is the amount value for this contract.
  amount: float64 @gte(0)
  /// currency is the currency value for this contract.
  currency: string @required
  /// due_date is the due date value for this contract.
  due_date: string @required
  /// status is the current lifecycle state.
  status: string @required
  /// description is the description value for this contract.
  description: string @required
}

message CreateBillResponse {
  /// id is the unique identifier for the resource.
  id: int64
  /// message is a human-readable result message.
  message: string
}

message DeleteBillRequest {
  id: int64 @required @gt(0)
}

message DeleteBillResponse {
  message: string
}

message GetBillRequest {
  id: int64 @required @gt(0)
}

message GetBillResponse {
  bill: Bill
}

message ListBillsRequest {
  page: int64 @query("page") @encode(number)
  page_size: int64 @query("page_size") @encode(number)
}

message ListBillsResponse {
  /// bills is the bills value for this contract.
  bills: Bill[]
  page: int64 @encode(number)
  page_size: int64 @encode(number)
  has_more: bool
}

message UpdateBillBody {
  /// supplier_id is the supplier id value for this contract.
  supplier_id: int64 @required @gt(0)
  /// amount is the amount value for this contract.
  amount: float64 @gte(0)
  /// currency is the currency value for this contract.
  currency: string @required
  /// due_date is the due date value for this contract.
  due_date: string @required
  /// status is the current lifecycle state.
  status: string @required
  /// description is the description value for this contract.
  description: string @required
}

message UpdateBillRequest {
  /// id is the unique identifier for the resource.
  id: int64 @required @gt(0)
  /// body carries updatable bill fields bound from the HTTP payload.
  body: UpdateBillBody
}

message UpdateBillResponse {
  /// message is a human-readable result message.
  message: string
}
