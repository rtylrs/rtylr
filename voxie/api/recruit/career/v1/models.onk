package recruit.career.v1

/// RecruitCareer is a job posting on the careers page.
message RecruitCareer {
  id: int64
  business_id: int64
  slug: string
  title: string
  department: string
  location: string
  employment_type: string
  work_mode: string
  seniority: string
  details: string
  requirements: string
  salary_min: string
  salary_max: string
  salary_currency: string
  is_published: bool
  is_active: bool
  created_at: string
  updated_at: string
}

/// Submission is a candidate's application to one career.
message Submission {
  id: int64
  career_id: int64
  candidate_name: string
  email: string
  phone: string
  resume_url: string
  cover_letter: string
  status: string
  career_title: string
  created_at: string
  updated_at: string
}

/// ListSubmissionsRequest selects submissions for this business.
message ListSubmissionsRequest {
  page: int64 @query("page") @encode(number)
  page_size: int64 @query("page_size") @encode(number)
}

/// ListSubmissionsResponse returns one page of submissions.
message ListSubmissionsResponse {
  submissions: Submission[]
  total: int64 @encode(number)
  page: int64 @encode(number)
  page_size: int64 @encode(number)
}

/// UpdateSubmissionStatusRequest advances a candidate through the funnel.
message UpdateSubmissionStatusRequest {
  /// body carries the submission id and new status bound from the HTTP payload.
  body: UpdateSubmissionStatusBody
}

/// UpdateSubmissionStatusBody carries the status transition.
message UpdateSubmissionStatusBody {
  /// id identifies the submission to update.
  id: int64? @required @gt(0)
  /// status is one of: pending | reviewing | interview | offer | hired | rejected.
  status: string @required
}

/// UpdateSubmissionStatusResponse confirms the transition.
message UpdateSubmissionStatusResponse {
  /// message is a human-readable result.
  message: string
}
