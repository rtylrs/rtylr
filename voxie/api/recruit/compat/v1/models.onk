package recruit.compat.v1

message EmptyRequest {}

/// Empty response for @http routes whose handler writes its own response.
message EmptyResponse {}

message JsonResponse {
  data: json @unwrap
}

message QueryRequest {
  slug: string? @query("slug")
  career_slug: string? @query("career_slug")
  career_id: int32? @query("career_id")
  submission_id: int32? @query("submission_id")
  status: string? @query("status")
  limit: int32? @query("limit")
  offset: int32? @query("offset")
}

message BodyRequest {
  body: json
}

message IdQueryRequest {
  id: string @query("id")
}

message PathIdRequest {
  id: string
}

message PathSourceIdRequest {
  source: string
  id: string
}
