package recruit.compat.v1

/// Typed compatibility surface for the deployed Recruit routes.
service CompatibilityService {
  base_path: "/recruit"

  listCareers(EmptyRequest) -> JsonResponse @get("/careers")
  createCareer(BodyRequest) -> JsonResponse @post("/careers") @body("body")
  updateCareer(BodyRequest) -> JsonResponse @put("/careers") @body("body")
  deleteCareer(IdQueryRequest) -> JsonResponse @delete("/careers")

  getCustomization(EmptyRequest) -> JsonResponse @get("/customization")
  updateCustomization(BodyRequest) -> JsonResponse @put("/customization") @body("body")
  listSubmissions(QueryRequest) -> JsonResponse @get("/submissions")
  updateSubmissionStatus(BodyRequest) -> JsonResponse @put("/submissions/status") @body("body")
  getResumeURL(QueryRequest) -> JsonResponse @get("/submissions/resume-url")

  listSections(EmptyRequest) -> JsonResponse @get("/sections")
  createSection(BodyRequest) -> JsonResponse @post("/sections") @body("body")
  updateSection(BodyRequest) -> JsonResponse @put("/sections") @body("body")
  deleteSection(IdQueryRequest) -> JsonResponse @delete("/sections")
  reorderSections(BodyRequest) -> JsonResponse @put("/sections/reorder") @body("body")

  listFormFields(QueryRequest) -> JsonResponse @get("/form-fields")
  createFormField(BodyRequest) -> JsonResponse @post("/form-fields") @body("body")
  updateFormField(BodyRequest) -> JsonResponse @put("/form-fields") @body("body")
  deleteFormField(IdQueryRequest) -> JsonResponse @delete("/form-fields")

  listPublicCareers(QueryRequest) -> JsonResponse @get("/public/careers")
  getPublicCareer(QueryRequest) -> JsonResponse @get("/public/career")

  getPublicBranding(EmptyRequest) -> JsonResponse @get("/public/branding")
  exportSubmissions(EmptyRequest) -> JsonResponse @get("/submissions/export")

  // The public apply and resume upload routes run inside per-route rate
  // limits a contract method cannot apply, so their original handlers serve
  // them.
  listPublicOg(EmptyRequest) -> EmptyResponse @get("/public/og") @http
  createPublicApply(EmptyRequest) -> EmptyResponse @post("/public/apply") @http
  createPublicResumeUploadUrl(EmptyRequest) -> EmptyResponse @post("/public/resume-upload-url") @http
}

/// Voxhire recruiting routes. The admin routes run behind the Voxhire admin
/// session guard and the login, contact and apply routes behind per-route
/// rate limits, so they are @http methods served by the original handlers.
service VoxhireService {
  base_path: "/voxhire"
  listAdminAdmins(EmptyRequest) -> EmptyResponse @get("/admin/admins") @http
  listAdminAnalytics(EmptyRequest) -> EmptyResponse @get("/admin/analytics") @http
  getAdminApplicationsCv(PathIdRequest) -> EmptyResponse @get("/admin/applications/{id}/cv") @http
  getAdminApplicationsTimeline(PathIdRequest) -> EmptyResponse @get("/admin/applications/{id}/timeline") @http
  listAdminCandidates(EmptyRequest) -> EmptyResponse @get("/admin/candidates") @http
  listAdminCvJobs(EmptyRequest) -> EmptyResponse @get("/admin/cv-jobs") @http
  listAdminLeads(EmptyRequest) -> EmptyResponse @get("/admin/leads") @http
  listAdminMe(EmptyRequest) -> EmptyResponse @get("/admin/me") @http
  listAdminOpenings(EmptyRequest) -> EmptyResponse @get("/admin/openings") @http
  getAdminOpeningsApplications(PathIdRequest) -> EmptyResponse @get("/admin/openings/{id}/applications") @http
  listAdminShortlists(EmptyRequest) -> EmptyResponse @get("/admin/shortlists") @http
  listAdminTasks(EmptyRequest) -> EmptyResponse @get("/admin/tasks") @http
  createAdminAdmins(EmptyRequest) -> EmptyResponse @post("/admin/admins") @http
  createAdminCareers(EmptyRequest) -> EmptyResponse @post("/admin/careers") @http
  createAdminLogin(EmptyRequest) -> EmptyResponse @post("/admin/login") @http
  createAdminShortlists(EmptyRequest) -> EmptyResponse @post("/admin/shortlists") @http
  createAdminShortlistsItems(PathIdRequest) -> EmptyResponse @post("/admin/shortlists/{id}/items") @http
  createAdminTasks(EmptyRequest) -> EmptyResponse @post("/admin/tasks") @http
  createApplications(EmptyRequest) -> EmptyResponse @post("/applications") @http @max_body("16MiB")
  createCareersApply(EmptyRequest) -> EmptyResponse @post("/careers/apply") @http @max_body("16MiB")
  createContact(EmptyRequest) -> EmptyResponse @post("/contact") @http
  updateAdminApplicationsReview(PathIdRequest) -> EmptyResponse @put("/admin/applications/{id}/review") @http
  updateAdminApplicationsStatus(PathIdRequest) -> EmptyResponse @put("/admin/applications/{id}/status") @http
  updateAdminCareers(PathIdRequest) -> EmptyResponse @put("/admin/careers/{id}") @http
  updateAdminCareersActive(PathIdRequest) -> EmptyResponse @put("/admin/careers/{id}/active") @http
  updateAdminCvJobsRetry(PathSourceIdRequest) -> EmptyResponse @put("/admin/cv-jobs/{source}/{id}/retry") @http
  updateAdminTasks(PathIdRequest) -> EmptyResponse @put("/admin/tasks/{id}") @http
}
