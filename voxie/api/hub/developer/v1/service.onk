package hub.developer.v1

/// DeveloperService defines hub developer API endpoints.
service DeveloperService {
  /// Returns API keys for the active business.
  listApiKeys(ListApiKeysRequest) -> ListApiKeysResponse @get("/api-keys")

  /// Creates a new API key.
  createApiKey(CreateApiKeyRequest) -> CreateApiKeyResponse @post("/api-keys")

  /// Revokes an existing API key.
  revokeApiKey(RevokeApiKeyRequest) -> RevokeApiKeyResponse @post("/api-keys/revoke")

  /// Returns configured webhooks.
  listWebhooks(ListWebhooksRequest) -> ListWebhooksResponse @get("/webhooks")

  /// Registers a new webhook endpoint.
  createWebhook(CreateWebhookRequest) -> CreateWebhookResponse @post("/webhooks")

  /// Updates an existing webhook.
  updateWebhook(UpdateWebhookRequest) -> UpdateWebhookResponse @put("/webhooks/{id}")

  /// Removes a webhook by ID.
  deleteWebhook(DeleteWebhookRequest) -> DeleteWebhookResponse @delete("/webhooks/{id}")
}
