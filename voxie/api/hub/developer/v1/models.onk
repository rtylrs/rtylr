package hub.developer.v1

message ApiKey {
  id: int64
  name: string
  /// First 8 chars shown
  key_prefix: string
  scopes: string[]
  created_at: string
  last_used_at: string
  expires_at: string
  is_active: bool
}

message Webhook {
  id: int64
  url: string
  events: string[]
  is_active: bool
  created_at: string
  last_triggered_at: string
}

message CreateApiKeyRequest {
  name: string @required
  scopes: string[] @min_items(1)
}

message CreateApiKeyResponse {
  id: int64
  key: string
  message: string
}

message CreateWebhookRequest {
  url: string @required
  events: string[] @min_items(1)
}

message CreateWebhookResponse {
  id: int64
  message: string
}

message DeleteWebhookRequest {
  id: int64 @gt(0)
}

message DeleteWebhookResponse {
  message: string
}

message ListApiKeysRequest {}

message ListApiKeysResponse {
  keys: ApiKey[]
}

message ListWebhooksRequest {}

message ListWebhooksResponse {
  webhooks: Webhook[]
}

message RevokeApiKeyRequest {
  id: int64 @gt(0)
}

message RevokeApiKeyResponse {
  message: string
}

message UpdateWebhookRequest {
  id: int64 @gt(0)
  url: string @required
  events: string[] @min_items(1)
  is_active: bool
}

message UpdateWebhookResponse {
  webhook: Webhook
}
