package hub.memory.v1

message ChatSummary {
  id: string
  title: string
  summary: string
  updated_at: string
  pinned: bool
  archived: bool
  project_id: string
}

message ChatMessage {
  id: string
  role: string
  content: string
  created_at: string
  tokens_used: int32
  attachments_json: string
  blocks_json: string
  response_ms: int32
}

message ListChatsRequest {
  limit: int32 @query("limit")
  offset: int32 @query("offset")
}

message ListChatsResponse {
  chats: ChatSummary[]
}

message GetChatMessagesRequest {
  session_id: string
}

message GetChatMessagesResponse {
  messages: ChatMessage[]
}

message DeleteChatRequest {
  session_id: string
}

message DeleteChatResponse {
  deleted: bool
}

message RenameChatRequest {
  session_id: string
  title: string
}

message RenameChatResponse {
  updated: bool
}

message PinChatRequest {
  session_id: string
  pinned: bool
}

message PinChatResponse {
  updated: bool
}

message CaretProject {
 id: string
 name: string
 icon: string
 color: string
 context: string
 updated_at: string
}
message ListProjectsRequest {}
message ListProjectsResponse { projects: CaretProject[] }
message SaveProjectRequest {
 id: string
 name: string
 icon: string
 color: string
 context: string
}
message SaveProjectResponse { project: CaretProject }
message ArchiveProjectRequest { id: string }
message ArchiveProjectResponse { archived: bool }
message SetChatProjectRequest {
 session_id: string
 project_id: string
}
message SetChatProjectResponse { updated: bool }

message CaretMemory {
 id: string
 type: string
 value: string
 created_at: string
 updated_at: string
 /// How Caret came to know it: "feedback" (distilled from rated replies),
 /// "chat" (picked up from a conversation) or empty (told or approved).
 origin: string
}
message ListMemoriesRequest {}
message ListMemoriesResponse { memories: CaretMemory[] }
message SaveMemoryRequest {
 id: string
 value: string
}
message SaveMemoryResponse { memory: CaretMemory }
message DeleteMemoryRequest { id: string }
message DeleteMemoryResponse { deleted: bool }
