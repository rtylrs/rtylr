package hub.memory.v1

service MemoryService {
 listProjects(ListProjectsRequest) -> ListProjectsResponse @get("/chat-projects")
 saveProject(SaveProjectRequest) -> SaveProjectResponse @post("/chat-projects")
 archiveProject(ArchiveProjectRequest) -> ArchiveProjectResponse @delete("/chat-projects/{id}")
 setChatProject(SetChatProjectRequest) -> SetChatProjectResponse @put("/chats/{session_id}/project")

 listMemories(ListMemoriesRequest) -> ListMemoriesResponse @get("/caret-memories")
 saveMemory(SaveMemoryRequest) -> SaveMemoryResponse @post("/caret-memories")
 deleteMemory(DeleteMemoryRequest) -> DeleteMemoryResponse @delete("/caret-memories/{id}")

  listChats(ListChatsRequest) -> ListChatsResponse @get("/chats")

  getChatMessages(GetChatMessagesRequest) -> GetChatMessagesResponse @get("/chats/{session_id}/messages")

  deleteChat(DeleteChatRequest) -> DeleteChatResponse @delete("/chats/{session_id}")

  renameChat(RenameChatRequest) -> RenameChatResponse @put("/chats/{session_id}")

  pinChat(PinChatRequest) -> PinChatResponse @put("/chats/{session_id}/pin")
}
