package hub.config.v1

message ConfigPayload {
  /// Identifies the business that owns this config. Serialized as a string
  /// in the legacy payload.
  owner_id: string
  site_name: string
  logo_url: string
  favicon_url: string
  meta_tags: string[]
  contact_email: string
  contact_number: string
  sender_email: string
  website: string
  maps_url: string
  address: string
  city: string
  zipcode: string
  country: string
  instagram: string
  maintenance_mode: bool
  maintenance_notice: string
  addons_enabled: bool
  enable_reviews: bool
  enable_wishlist: bool
  enable_newsletter_signup: bool
  about_content: string
  footer_sub_text: string
  slug: string
}

message CreateConfigRequest {
  /// Accepted for legacy compatibility; the server derives the owning
  /// business from the authenticated user.
  owner: string
  key: string @required
  value: string @required
  description: string
}

message CreateConfigResponse {
  /// Identifies the created config.
  config_id: int64
  message: string
}

message GetConfigRequest {}

message GetConfigResponse {
  /// business is declared in hub.business.v1 - a cross-package reference.
  business: hub.business.v1.Business
  maintenance: bool
}

message IndustryType {
  slug: string
  label: string
  icon: string
}

message IndustryGroup {
  category: string
  types: IndustryType[]
}

message GetIndustriesRequest {}

message GetIndustriesResponse {
  groups: IndustryGroup[]
}

message UpdateConfigRequest {
  /// Absent means unchanged.
  site_name: string? @nullable
  logo_url: string? @nullable
  favicon_url: string? @nullable
  contact_email: string? @nullable
  contact_number: string? @nullable
  sender_email: string? @nullable
  website: string? @nullable
  maps_url: string? @nullable
  address: string? @nullable
  city: string? @nullable
  zipcode: string? @nullable
  country: string? @nullable
  instagram: string? @nullable
  maintenance_mode: bool? @nullable
  maintenance_notice: string? @nullable
  addons_enabled: bool? @nullable
  enable_reviews: bool? @nullable
  enable_wishlist: bool? @nullable
  enable_newsletter_signup: bool? @nullable
  about_content: string? @nullable
  footer_sub_text: string? @nullable
}

message UpdateConfigResponse {
  message: string
  config: ConfigPayload
}
