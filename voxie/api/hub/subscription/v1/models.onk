package hub.subscription.v1

message Subscription {
  id: int64
  plan_name: string
  plan_slug: string
  apps: string[]
  price_per_seat_cents: int32
  status: string
  is_granted: bool
  seat_count: int32
  included_seat_limit: int32
  included_seat_count: int32
  billable_seat_count: int32
  grant_expires_at: string?
  trial_ends_at: string?
  next_billing_date: string?
  paddle_subscription_id: string
}

message Plan {
  id: int64
  name: string
  slug: string
  apps: string[]
  price_per_seat_cents: int32
  annual_price_per_seat_cents: int32
  trial_days: int32
  tagline: string
  max_seats: int32?
  max_locations: int32?
  ai_credits_per_month: int32
  features: string[]
  tier_order: int32
  is_solo: bool
  is_featured: bool
  is_active: bool
}

message BillingLineItem {
  period_start: string
  period_end: string?
  seat_count: int32
  included_seat_limit: int32
  included_seat_count: int32
  billable_seat_count: int32
  included_cents: int32
  price_per_seat_cents: int32
  amount_cents: int32
  type: string
  description: string
  is_granted: bool
  grant_expires_at: string?
  addon_id: string
  quantity: int32
  unit_price_cents: int32
}

message BillingDetail {
  billing_month: string
  next_billing_date: string?
  line_items: BillingLineItem[]
  total_cents: int32
  plan_name: string
  price_per_seat_cents: int32
  current_seat_count: int32
  included_seat_limit: int32
  included_seat_count: int32
  billable_seat_count: int32
  seat_discount_cents: int32
  status: string
  is_granted: bool
  grant_expires_at: string?
  trial_ends_at: string?
  paddle_subscription_id: string
}

message BillingHistoryMonth {
  month: string
  total_cents: int32
  line_items: BillingLineItem[]
  status: string
}

message GetMySubscriptionRequest {}

message GetMySubscriptionResponse {
  subscription: Subscription
}

message ListPlansRequest {}

message ListPlansResponse {
  plans: Plan[]
}

message GetBillingDetailRequest {}

message GetBillingDetailResponse {
  billing: BillingDetail
}

message GetBillingHistoryRequest {}

message GetBillingHistoryResponse {
  history: BillingHistoryMonth[]
}

message UpsertSubscriptionRequest {
  plan_slug: string
}

message UpsertSubscriptionResponse {
  message: string
}

message CreateCheckoutRequest {
  plan_slug: string
  email: string
  billing_cycle: string?
  seat_count: int32?
  addons: string[]
}

message CreateCheckoutResponse {
  checkout_url: string
}
