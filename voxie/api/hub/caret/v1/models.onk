package hub.caret.v1

message CaretTool {
  name: string
  label: string
  description: string
  category: string
  requires_approval: bool
  /// Access scope of this tool: "read" or "write". Mirrors the server-side
  /// gating already applied in ask/analyst modes; exposed so the UI can
  /// surface it too (e.g. counting write-scoped tools).
  scope: string
}

message ListCaretToolsRequest {
  mode: string
}

message ListCaretToolsResponse {
  tools: CaretTool[]
}

/// Image inputs accepted by the authenticated Caret SSE endpoint. At most four
/// raster images, two MiB combined; SVG and remote URLs are not accepted.
message CaretImageInput {
 name: string
 data_url: string
}

/// A tool contract as the runtime registry describes it.
message CaretToolDef {
  name: string
  description: string
  module: string
  scope: string
  requires_approval: bool
  input_hint: string
  output_hint: string
  freshness: string
  side_effect: string
  approval_reason: string
}

message ListToolsRequest {
  mode: string @query("mode")
}

message ListToolsResponse {
  tools: CaretToolDef[]
}

message GetProviderStatusRequest {}

message GetProviderStatusResponse {
  available: bool
  primary_provider: string
  /// Provider name to availability.
  providers: json
}

/// Approve or deny a pending tool call. input is the tool's JSON input.
message ToolDecisionRequest {
  tool_call_id: string
  name: string
  input: json
  decision: string
  mode: string
  /// The chat the proposal came from. The outcome is recorded there so
  /// Caret knows in later turns what was done or skipped.
  session_id: string
}

message ToolDecisionResponse {
  tool_call_id: string
  status: string
  message: string
  executed: bool
  tool: CaretToolDef
  preview: string
  output: json
  duration_ms: int64 @encode(number)
}

message StopReplyRequest {
  session_id: string
}

message StopReplyResponse {
  /// False when no reply was generating in the chat.
  stopped: bool
}

message RateReplyRequest {
  session_id: string
  /// The stored message id of the reply; empty rates the chat's latest reply.
  message_id: string
  /// "up", "down", or "clear" to remove a verdict.
  rating: string
  /// What was wrong or right, in the person's words. Optional.
  reason: string
}

message RateReplyResponse {
  saved: bool
}

message BuddySettings {
  enabled: bool
  instructions: string
  interval_minutes: int32
  daily_run_cap: int32
  run_as_user_id: int64 @encode(number)
}

message GetBuddySettingsRequest {}
message GetBuddySettingsResponse { settings: BuddySettings }
message PutBuddySettingsRequest {
  enabled: bool
  instructions: string
  interval_minutes: int32
  daily_run_cap: int32
}
message PutBuddySettingsResponse { settings: BuddySettings }

message BuddyRun {
  id: int64 @encode(number)
  trigger_kind: string
  status: string
  report: string
  error: string
  tool_calls: int32
  tokens: int64 @encode(number)
  created_at: string
  started_at: string
  finished_at: string
}
message ListBuddyRunsRequest {}
message ListBuddyRunsResponse { runs: BuddyRun[] }

message BuddyAction {
  id: int64 @encode(number)
  run_id: int64 @encode(number)
  tool_name: string
  input: json
  status: string
  decided_by: int64 @encode(number)
  result: json
  expires_at: string
  created_at: string
  decided_at: string
}
message ListBuddyActionsRequest { status: string @query("status") }
message ListBuddyActionsResponse { actions: BuddyAction[] }
message DecideBuddyActionRequest {
  action_id: int64 @encode(number)
  decision: string
}
message DecideBuddyActionResponse { action: BuddyAction }

message GetBuddyThreadRequest {}
message GetBuddyThreadResponse {
  session_id: string
  last_post_at: string
}

message BuddyRoutine {
  id: int64 @encode(number)
  name: string
  instructions: string
  every_minutes: int32
  enabled: bool
  next_run_at: string
  last_run_at: string
}
message ListBuddyRoutinesRequest {}
message ListBuddyRoutinesResponse { routines: BuddyRoutine[] }
message SetBuddyRoutineEnabledRequest {
  id: int64 @encode(number)
  enabled: bool
}
message SetBuddyRoutineEnabledResponse { routine: BuddyRoutine }
message DeleteBuddyRoutineRequest { id: int64 @encode(number) }
message DeleteBuddyRoutineResponse {}
