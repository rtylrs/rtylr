package hub.permission.v1

message PermissionMatrix {
  rows: PermissionRow[]
  roles: string[]
}

message PermissionRow {
  key: string
  category: string
  label: string
  /// role -> enabled
  role_values: map[string, bool]
}

message CustomRole {
  id: int64
  name: string
  description: string
  permissions: string[]
  member_count: int32
  /// When the record was created.
  created_at: string
}

message GetPermissionsRequest {}

message GetPermissionsResponse {
  matrix: PermissionMatrix
}

message ListRolesRequest {}

message ListRolesResponse {
  roles: CustomRole[]
}

message CreateRoleRequest {
  name: string @required
  description: string
  permissions: string[]
}

message CreateRoleResponse {
  role: CustomRole
}

message DeleteRoleRequest {
  id: int64 @required @gt(0)
}

message DeleteRoleResponse {
  message: string
}

message UpdateRoleBody {
  /// The role name.
  name: string @required
  permissions: string[]
}

message UpdateRoleRequest {
  id: int64 @required @gt(0)
  body: UpdateRoleBody
}

message UpdateRoleResponse {
  message: string
}

message UpdatePermissionMatrixRequest {
  role: string @required
  permission_key: string @required
  enabled: bool
}

message UpdatePermissionMatrixResponse {
  success: bool
}
