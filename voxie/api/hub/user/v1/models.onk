package hub.user.v1

message GetMeRequest {}

message GetMeResponse {
  id: int64
  /// Email address used for lookup or contact.
  email: string
  full_name: string
  apps: string[]
  role: string
  business_id: int64
  business_name: string
  is_owner: bool
  /// is_console_admin indicates the user can access the internal console.
  is_console_admin: bool
  onboarded: bool
}

message UpdateProfileRequest {
  name: string @required
  /// Reserved for future profile email changes.
  email: string? @nullable @email
}

message UpdateProfileResponse {
  user: GetMeResponse
}

message ChangePasswordRequest {
  current_password: string @required
  new_password: string @required
}

message ChangePasswordResponse {}

message SwitchBusinessRequest {
  /// Business to activate in the current session.
  business_id: int64 @required @gt(0)
}

message SwitchBusinessResponse {
  /// Fresh JWT scoped to the selected business.
  token: string
}
