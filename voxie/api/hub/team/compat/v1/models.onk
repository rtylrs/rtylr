package hub.team.compat.v1

message TeamMember {
  id: string
  name: string
  email: string
  role: string
  apps: string[]
  is_active: bool
}

message ListMembersRequest {}

message ListMembersResponse {
  users: TeamMember[]
  members: TeamMember[]
}

message InviteMemberBody {
  email: string
  full_name: string
  role: string
  apps: string[]
}

message InviteMemberRequest {
  body: InviteMemberBody
}

message EmptyJsonResponse {
  data: json @unwrap
}

message DeactivateMemberRequest {
  id: string
  body: json
}
