package hub.team.permissions.v1

message UpdatePermissionsRequest {
  user_id: int64 @gt(0)
  /// Use admin for a full-access business administrator, otherwise member.
  member_type: string
  /// App licenses assigned directly to this member.
  licensed_app_ids: string[]
  /// Replace direct app licenses when true.
  replace_licensed_app_ids: bool
  full_name: string?
  /// Direct permission profiles assigned to the member.
  permission_profile_assignments: hub.user.v1.PermissionProfileAssignment[]
  /// Replace direct permission profiles when true.
  replace_permission_profile_assignments: bool
  /// Groups that provide inherited access.
  group_ids: int64[]
  /// Replace group memberships when true.
  replace_group_ids: bool
}

message UpdatePermissionsResponse {
  /// Effective access after the update.
  effective_access: hub.user.v1.EffectiveAccess?
}
