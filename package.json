{
  "name": "rtylr-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root: the shared library layer and every product workspace under apps/",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "check:scripts": "node scripts/check-workspace-scripts.mjs",
    "lint": "eslint apps/rtylr/apps packages",
    "lint:fix": "eslint apps/rtylr/apps packages --fix"
  },
  "devDependencies": {
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "^8.59.0"
  }
}
