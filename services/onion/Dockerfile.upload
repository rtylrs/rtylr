# Dockerfile for the `upload` runmode (cmd/upload) — the CDN service.
# Three stages: build the C++ media-engine, build the Go binary, then a
# slim debian runtime carrying libvips + ffmpeg so the media-engine runs.

# ── Stage 1: media-engine (C++ / libvips) ──────────────────────────────────
FROM debian:bookworm-slim AS media-engine
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake build-essential pkg-config \
    libvips-dev \
    ffmpeg libavcodec-dev libavformat-dev libavutil-dev libswscale-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY media-engine/CMakeLists.txt .
COPY media-engine/src/     src/
COPY media-engine/include/ include/
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --parallel "$(nproc)"

# ── Stage 2: Go binary ──────────────────────────────────────────────────────
# Build on the native runner arch and cross-compile to TARGETARCH — faster than
# building under arm64 emulation. The media-engine stage above still builds for
# the target arch (emulated for arm64).
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS go-builder
WORKDIR /app
RUN apk add --no-cache ca-certificates bash git
COPY . .
RUN set -eux; \
    if [ ! -f ./voxie/go.mod ]; then \
      git clone --depth 1 https://github.com/tryrtylr/voxie.git ./voxie; \
    fi
RUN go mod download && go mod verify
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w \
      -X 'github.com/voxire/onion/internal/platform/server/http.Version=${VERSION}' \
      -X 'github.com/voxire/onion/internal/platform/server/http.Commit=${COMMIT}' \
      -X 'github.com/voxire/onion/internal/platform/server/http.BuildTime=${BUILD_TIME}'" \
    -o /app/upload ./cmd/upload

# ── Stage 3: runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata libvips42 ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=go-builder   /app/upload                  /app/upload
COPY --from=media-engine /build/build/media-engine    /usr/local/bin/media-engine
RUN useradd --system --no-create-home --shell /usr/sbin/nologin app
# Point the Go binary at the media-engine installed on PATH.
ENV MEDIA_ENGINE_PATH=/usr/local/bin/media-engine
ENV PORT=8080
EXPOSE 8080
USER app
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/bin/sh", "-c", "kill -0 1"]
CMD ["/app/upload"]
