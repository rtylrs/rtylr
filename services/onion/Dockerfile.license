# Dockerfile for the `license` runmode (cmd/license) — self-host license status
# and verification API. No DB connection is opened by this service.

# Build stage
FROM golang:1.26-alpine AS builder
WORKDIR /app
RUN apk add --no-cache ca-certificates curl bash
RUN curl -sSL https://github.com/sqlc-dev/sqlc/releases/download/v1.29.0/sqlc_1.29.0_linux_amd64.tar.gz \
    | tar -xz -C /usr/local/bin sqlc
RUN go install github.com/bufbuild/buf/cmd/buf@v1.65.0 && \
    go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.11
COPY go.mod go.sum ./
COPY voxie/go.mod voxie/go.sum* ./voxie/
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY scripts ./scripts
COPY voxie ./voxie
RUN chmod +x scripts/*.sh && \
    bash scripts/generate_sqlc.sh && \
    bash scripts/generate_contracts.sh
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w \
      -X 'github.com/voxire/onion/internal/platform/server/http.Version=${VERSION}' \
      -X 'github.com/voxire/onion/internal/platform/server/http.Commit=${COMMIT}' \
      -X 'github.com/voxire/onion/internal/platform/server/http.BuildTime=${BUILD_TIME}'" \
    -o /app/license ./cmd/license

# Runtime stage
FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/license /app/license
ENV RUN_MODE=license
ENV SERVICE_NAME=license
ENV PORT=8082
EXPOSE 8082
CMD ["/app/license"]
