# Dockerfile for the `worker` runmode (cmd/worker) — the email-queue worker.
# No HTTP server, no media-engine: a small static Go binary on alpine.

# ── Build stage ──────────────────────────────────────────────────────────────
FROM golang:1.26-alpine AS builder
WORKDIR /app
RUN apk add --no-cache ca-certificates
# voxie is a local `replace` target, so its module file must be present.
COPY go.mod go.sum ./
COPY voxie/go.mod voxie/go.sum* ./voxie/
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY voxie ./voxie
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w \
      -X 'github.com/voxire/onion/internal/platform/server/http.Version=${VERSION}' \
      -X 'github.com/voxire/onion/internal/platform/server/http.Commit=${COMMIT}' \
      -X 'github.com/voxire/onion/internal/platform/server/http.BuildTime=${BUILD_TIME}'" \
    -o /app/worker ./cmd/worker

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:latest
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/worker /app/worker
CMD ["/app/worker"]
