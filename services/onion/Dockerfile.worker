# Dockerfile for the `worker` runmode (cmd/worker) — the email-queue worker.
# No HTTP server, no media-engine: a small static Go binary on alpine.
#
# Build from the repository root so the service and the contract module are both
# in context: docker build -f services/onion/Dockerfile.worker .

# ── Build stage ──────────────────────────────────────────────────────────────
# Build on the native runner arch and cross-compile to TARGETARCH (the builder
# downloads an amd64 sqlc, which can't run under arm64 emulation).
FROM --platform=$BUILDPLATFORM golang:1.26-alpine3.22 AS builder
WORKDIR /src
RUN apk add --no-cache ca-certificates curl bash
# sqlc: the worker imports the email package, whose generated query code is
# produced by scripts/generate_sqlc.sh (gitignored, regenerated per build).
RUN set -eux; \
    if curl --fail --location --retry 5 --retry-all-errors --retry-delay 2 \
        --output /tmp/sqlc.tar.gz \
        https://github.com/sqlc-dev/sqlc/releases/download/v1.29.0/sqlc_1.29.0_linux_amd64.tar.gz; then \
      tar -xzf /tmp/sqlc.tar.gz -C /usr/local/bin sqlc; \
    else \
      GOBIN=/usr/local/bin go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.29.0; \
    fi; \
    rm -f /tmp/sqlc.tar.gz; \
    sqlc version
# Generated contract output is gitignored, so produce it from the pinned onek
# release before Go compiles against it.
COPY voxie/ ./voxie/
RUN GOBIN=/usr/local/bin go install github.com/1homsi/onekit/cmd/onek@v0.19.0 && \
    cd /src/voxie && onek build .
COPY services/onion/ ./services/onion/
WORKDIR /src/services/onion
RUN set -eux; \
    test -f /src/voxie/go.mod; \
    test -f ./internal/platform/database/schemas/hr_core/schema.sql; \
    test -d ./internal/platform/email/templates
RUN go mod download && go mod verify
RUN chmod +x scripts/*.sh && \
    bash scripts/generate_sqlc.sh
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w \
      -X 'github.com/voxire/onion/internal/platform/server/http.Version=${VERSION}' \
      -X 'github.com/voxire/onion/internal/platform/server/http.Commit=${COMMIT}' \
      -X 'github.com/voxire/onion/internal/platform/server/http.BuildTime=${BUILD_TIME}'" \
    -o /app/worker ./cmd/worker

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
RUN addgroup -S app && adduser -S -G app app
WORKDIR /app
COPY --from=builder /app/worker /app/worker
USER app
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["sh", "-c", "kill -0 1"]
CMD ["/app/worker"]
