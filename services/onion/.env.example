# onion — backend env template. Copy to .env (never commit it) and
# fill in what your local setup needs. Anything marked OPTIONAL can be
# left blank; the server falls back to a safe default or skips the
# feature.

# ---- Runtime ---------------------------------------------------------
APP_ENV=development
# api, upload, worker, or license. Local `go run ./cmd/api` can omit this.
RUN_MODE=api
# hosted keeps cloud behavior; self_hosted enables license status checks.
DEPLOYMENT_MODE=hosted
# Release tag surfaced in Sentry. Usually the git SHA at build time.
APP_RELEASE=
PORT=8080
SERVICE_NAME=onion
AUTH_URL=
API_URL=
TRUSTED_PROXY_CIDRS=

# Optional diagnostics.
PPROF_ENABLED=false
PPROF_PORT=6060
PROBE_PORT=8081
PROBE_METRICS_ENABLED=false
HTTP_ACCESS_LOGS=false
ACCESS_LOGS=false
AUTH_REQUEST_LOGS=false
AUTH_SUCCESS_LOGS=false
VALIDATE_RESPONSE_PROTOS=false
RESPONSE_PROTO_VALIDATION=false

# ---- Database (required) --------------------------------------------
# These are the local Docker environment's own values: run `make local-env-up`
# and they work unchanged. Nothing else needs configuring to develop.
#
# Do not point these at a managed database. With APP_ENV=development the server
# refuses to start against a host that is not on this machine, because a config
# labelled development that reaches a real database is one command away from
# writing to it. If a development run genuinely needs an off-box database, set
# ALLOW_REMOTE_DB=true and mean it.
#
# In production DATABASE_URL is set instead and these are left unset.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=onion_dev
DB_USER=onion_user
DB_PASSWORD=onion_password
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m
DB_REPLICA_HOST=
DB_REPLICA_PORT=3306
DB_AI_USER=
DB_AI_PASSWORD=
LOGGING_DATABASE_URL=

# ---- Auth (required) ------------------------------------------------
# ≥ 32 chars. Rotate on a leak; invalidates every existing JWT.
JWT_SECRET=your_jwt_secret_min_32_chars
# Access-token lifetime. Must be a positive Go duration (default: 24h).
JWT_DURATION=24h
INTERNAL_TOKEN=
# Shared key the Partials internal tooling sends as the X-API-KEY header. When
# set, a matching request skips the global middleware chain (security, rate
# limit, auth, subscription, license, idempotency), attaches a console_admin
# identity, and reaches internal endpoints. Leave blank to disable the bypass.
PARTIALS_API_KEY=
# User id the X-API-KEY bypass acts as (audit and license writes record it).
# Defaults to 0 when unset.
PARTIALS_ACTOR_USER_ID=

# Destructive probe control (optional; POST /stop is disabled when empty).
PROBE_STOP_TOKEN=

# Google OAuth — the backend verifies Firebase / Google ID tokens
# against this client ID. Get it from Google Cloud Console ("Web
# application" credentials). Leave blank to disable Google login.
GOOGLE_OAUTH_CLIENT_ID=

# WorkOS OAuth (optional; used by the social-login flow).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=

# ---- Cache (optional) -----------------------------------------------
REDIS_ENABLED=false
REDIS_HOSTS=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_URL=

# In-process LRU. Fine to leave at the default.
INMEMORY_CACHE_MAX_SIZE_MB=64

# ---- Trino analytics (optional) -------------------------------------
# OLAP warehouse for cross-tenant reporting. Leave TRINO_ENABLED=false
# (default) and no Trino connection is opened.
TRINO_ENABLED=false
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=
TRINO_PASSWORD=
# JWT alternative to password (HTTPS coordinators).
TRINO_ACCESS_TOKEN=
TRINO_CATALOG=
TRINO_SCHEMA=
TRINO_TLS=false
TRINO_SOURCE=onion

# ---- Observability --------------------------------------------------
# Backend Sentry project (distinct from the frontend DSN). Leave
# blank and panics are logged but not reported.
SENTRY_DSN=

# Better Stack structured logging — warn+error records only, 30s dedup window.
# Leave the token blank for the stdout-only fallback. The ingesting host is
# optional and defaults to Better Stack's global ingestion endpoint.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=

# Slack logging (optional; disabled unless explicitly enabled).
SLACK_LOGGING_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_ALERTS_CHANNEL_ID=
SLACK_REQUEST_LOGS_CHANNEL=
SLACK_SUSPICIOUS_REQUESTS_CHANNEL=
SLACK_DASHBOARD_CHANNEL_ID=

# Google Sheets lead logging (optional).
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_LEAD_SHEET_ID=

# ---- /metrics endpoint ----------------------------------------------
# Prometheus scrape credentials. If either is empty the /metrics
# endpoint returns 404 — the feature is opt-in rather than
# accidentally exposed.
METRICS_USER=
METRICS_PASS=

# ---- Email (optional) -----------------------------------------------
RESEND_API_KEY=
# Comma-separated recipients of website lead notifications (/contact, /quote).
# Unset means the compiled-in Voxire team list.
LEAD_NOTIFY_EMAILS=
# Comma-separated recipients of newsletter signup notifications (/newsletter).
# Unset means info@voxire.com.
NEWSLETTER_NOTIFY_EMAILS=
# Resend audience that voxire.com newsletter subscribers are mirrored into by
# the worker job websitelead.sync_newsletter_audience. Needs a Resend key with
# contact permissions (a "sending access" key cannot add contacts). Unset
# disables the mirror.
RESEND_AUDIENCE_ID=
# Full-access key for the Resend account that owns that audience, when it is
# not the sending account. Unset means RESEND_API_KEY is used for contacts too.
RESEND_AUDIENCE_KEY=
# Cron for the audience mirror job. Default: every 5 minutes.
NEWSLETTER_AUDIENCE_SYNC_SCHEDULE=

# ---- AI integrations (optional, echo module) ------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=
GEMINI_API_KEY=
# Optional final fallback through OpenCode Zen's hosted API (not the local CLI).
# Uses the paid minimax-m2.7 model; leave empty to disable.
OPENCODE_API_KEY=
# Optional override for the form-mapping classifier checkpoint used by Caret
# (directory, .safetensors, or .json path). The API image bundles cua-s1-forms
# at /app/models/cua-s1-forms; empty falls back to the lexical matcher.
FORM_MAPPING_CHECKPOINT_PATH=

# ---- AWS S3 (optional, recruit resume uploads) ----------------------
# In production (EC2 with IAM instance role), only S3_BUCKET_NAME is
# needed — credentials come from the instance role automatically.
# Leave blank and resume upload degrades to the "paste a link" fallback.
S3_BUCKET_NAME=
S3_REGION=eu-west-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# R2_* variables are not supported; use S3_* for S3-compatible providers.

# ---- Floci (optional, local object storage) -------------------------
# When enabled, recruit resume uploads use local S3-compatible storage
# instead of AWS S3. `make local-env-up` creates this bucket.
FLOCI_ENABLED=false
FLOCI_ENDPOINT=http://localhost:4566
FLOCI_REGION=us-east-1
FLOCI_BUCKET=onion-dev

# ---- Upload/CDN runmode ---------------------------------------------
# The upload runmode is the only service that should accept media uploads.
# Apps store the returned CDN URL/key in their own tables.
CDN_BASE_URL=http://localhost:8081
CDN_MAX_UPLOAD_MB=100
CDN_API_KEY=
MEDIA_ENGINE_PATH=./media-engine/build/media-engine

# Nudity filter on stored image uploads — on by default; set
# CDN_MODERATION_ENABLED=false to opt out. Provider "openai" uses the free
# moderation endpoint (requires OPENAI_API_KEY); "local" is an in-process
# skin-tone heuristic (no network, less accurate) and is the automatic
# fallback when no OpenAI key is set. FAIL_CLOSED=true rejects uploads when
# the moderation check itself errors.
CDN_MODERATION_ENABLED=true
CDN_MODERATION_PROVIDER=openai
CDN_MODERATION_FAIL_CLOSED=false

# ---- License / self-hosting -----------------------------------------
# Used by cmd/license and, later, by API enforcement checks. Hosted deploys
# may leave these blank. Self-hosted deploys should set DEPLOYMENT_MODE above
# and provide either LICENSE_KEY or LICENSE_FILE plus LICENSE_PUBLIC_KEY.
LICENSE_KEY=
LICENSE_FILE=
LICENSE_PUBLIC_KEY=
# Hosted API only: private Ed25519 seed/key used by console admins to issue
# sales-approved self-host keys. Never place this in self-host installs.
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_ISSUER=voxire
LICENSE_GRACE_PERIOD=336h
LICENSE_CLOCK_STATE_FILE=/var/lib/rtylr/license-clock.json
# Override only, for our own testing and for an internal mirror: the hosted
# authority a self-host backend validates RTYLR_LICENSE_KEY against. Blank
# means the built-in default. Not a documented customer knob.
LICENSE_AUTHORITY_URL=

# ---- Paddle billing --------------------------------------------------
# Paddle is the billing provider for subscriptions (and, per P10, POS
# transactions). Matches the keys read in
# internal/platform/config/paddle.go. `PADDLE_SANDBOX=true` points the
# client at sandbox-api.paddle.com; anything else uses production.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_SANDBOX=true
PADDLE_ALLOW_INSECURE_WEBHOOKS=0

# ---- Email encryption and AI response cache (optional) ---------------
EMAIL_ENCRYPTION_KEY=
AI_RESPONSE_CACHE_ENABLED=false
AI_RESPONSE_CACHE_TTL=15m

# ---- Scheduler and provider overrides (optional) ---------------------
SCHEDULER_ENABLED=true
SCHEDULER_DISABLED=false
RUN_JOB=
JOB_TIMEOUT=90s
DEEPSEEK_API_KEY=
NVIDIA_NIM_API_KEY=
AI_PRIMARY_PROVIDER=
ALLOW_REMOTE_DB=false
ALLOW_PRODUCTION_DB=false
SELF_HOSTED=false
RTYLR_LICENSE_KEY=
UPLOAD_URL=

# ---- Authorization and MFA -------------------------------------------
# AUTHORIZATION_V2_MODE=legacy pins the platform to the pre-v2 authorization
# path (internal/platform/auth/auth.go). Anything else, including blank, runs
# v2. Blank is the intended production value.
AUTHORIZATION_V2_MODE=
# Symmetric key used to encrypt stored MFA secrets
# (internal/modules/security/internal/application/mfa.go). Required wherever
# MFA enrolment is enabled; leave blank here and set it per environment.
MFA_ENCRYPTION_KEY=
# Test-only opt-in. Set to 1 to run the direct authorization evidence suite
# (internal/testutil/direct_authorization.go), which is skipped otherwise. It
# lives in a non-test file, which is why it reaches this index; it has no
# meaning in a deployed environment.
DIRECT_AUTHORIZATION_EVIDENCE=
