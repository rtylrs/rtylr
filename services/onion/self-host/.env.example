# Copy to self-host/.env before running docker compose.

APP_ENV=production
DEPLOYMENT_MODE=self_hosted
AUTH_APP_URL=http://localhost:3000

# Replace before exposing this outside your machine.
JWT_SECRET=replace_with_at_least_32_random_characters

# Database
MYSQL_DATABASE=onion_self_host
MYSQL_USER=onion_user
MYSQL_PASSWORD=onion_password
MYSQL_ROOT_PASSWORD=onion_root_password
DB_HOST=db
DB_PORT=3306
DB_NAME=onion_self_host
DB_USER=onion_user
DB_PASSWORD=onion_password

# Cache
REDIS_ENABLED=true
REDIS_HOSTS=redis:6379
REDIS_URL=redis://redis:6379

# Local S3-compatible storage for uploads.
FLOCI_ENABLED=true
FLOCI_ENDPOINT=http://floci:4566
FLOCI_REGION=us-east-1
FLOCI_BUCKET=rtylr-self-host
S3_REGION=us-east-1

# Public URL that browsers/apps use for uploaded assets.
CDN_BASE_URL=http://localhost:8081
CDN_MAX_UPLOAD_MB=100
CDN_API_KEY=replace_with_random_upload_api_key

# License service. Hosted deployments leave these blank; self-hosted
# deployments should provide a signed key. Released vendor images embed the
# matching Ed25519 public key at build time; customers must not provide one.
LICENSE_KEY=
LICENSE_FILE=
LICENSE_ISSUER=voxire
LICENSE_GRACE_PERIOD=24h
LICENSE_VENDOR_PUBLIC_KEY=

# Optional observability/integrations.
SENTRY_DSN=
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
RESEND_API_KEY=
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_NIM_API_KEY=
AI_PRIMARY_PROVIDER=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_SANDBOX=true
