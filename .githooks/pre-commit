#!/usr/bin/env sh

# Load-bearing: without it only the exit status of the *last* command reaches
# git, so a failed `pnpm exec lint-staged` was discarded and this hook exited 0
# for every commit, blocking nothing. It also makes a failed `cd` stop instead
# of running the checks in the wrong directory.
set -e

# Formats only the files being committed.
#
# This used to run `pnpm format:check` across the whole tree, which made the gate
# unenforceable across more than one machine: a single commit that skipped the
# hook, or was pushed straight to main, left everybody else's commits blocked
# until someone swept the tree. People then bypassed with --no-verify, which
# admitted the next unformatted change. That loop produced a 204-file backlog
# from 21 scripted commits, and two full-tree sweeps in nine hours.
#
# Scoped to staged files, nobody inherits anyone else's debt and a direct push
# cannot poison the gate.
cd "$(git rev-parse --show-toplevel)/clients/web/rtylr"
pnpm exec lint-staged

echo "Checking OneKit boundary..."
pnpm contracts:enforce
