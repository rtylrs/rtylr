# See http://help.github.com/ignore-files/ for more about ignoring files.

# Patterns here are deliberately unanchored: the rtylr workspace lives under
# apps/rtylr, and landing/pos will sit beside it, so a build artifact must be
# ignored wherever its project sits.

# compiled output
dist/
tmp/
out-tsc/

# dependencies
node_modules

# IDEs and editors
.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
.sass-cache
connect.lock
coverage/
libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
typings/

# System Files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.*.local

# Next.js
.next/
out/

# Nx
.nx/cache
.nx/workspace-data
apps/*/build
apps/*/apps/*/build

# Turborepo
.turbo/

# AI agent config: local to each machine, per the agreement in #33
.claude/
CLAUDE.md
AGENTS.md

# Playwright artifacts
playwright-report/
test-results/

# AI agent config: local to each machine, never committed
.opencode/
opencode.jsonc
dummy-non-existing-folder/

# e2e screenshots are review artefacts for PR bodies, not fixtures.
e2e/__screenshots__/

# Machine-readable record of the last suite run, so a flake that appears once
# leaves evidence behind. See rtylr#988.
.vitest-report.json
