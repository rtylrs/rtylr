package erp.inventory.v1

message InventoryReportItem {
  product_id: int64
  product_name: string
  sku: string
  unit: string
  stock_quantity: float64
  low_stock_threshold: float64
  reorder_quantity: float64
  cost_price: float64
  sale_price: float64
  stock_value: float64
  is_low_stock: bool
}

message ValuationItem {
  category_name: string
  warehouse_name: string
  total_items: int64
  total_value: float64
  total_cost: float64
}

message AdjustInventoryRequest {
  product_id: int64 @required @gt(0)
  change: float64 @required @gt(0)
  type: string @required
  notes: string
}

message AdjustInventoryResponse {
  /// A human-readable result message.
  message: string
}

message GetInventoryReportRequest {}

message GetInventoryReportResponse {
  items: InventoryReportItem[]
  total_value: float64
}

message GetLowStockRequest {}

message GetLowStockResponse {
  items: InventoryReportItem[]
  count: int64 @encode(number)
}

message GetValuationRequest {}

message GetValuationResponse {
  items: ValuationItem[]
  total_value: float64
}
