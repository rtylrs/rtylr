package erp.variant.v1

message Variant {
  id: int64
  owner_id: int64
  business_id: int64
  product_id: int64
  name: string
  sku: string
  barcode: string
  cost_price: float64
  sale_price: float64
  stock_quantity: float64
  attributes: string
  is_active: bool
  created_at: string
  updated_at: string
}

message CreateVariantRequest {
  product_id: int64 @required @gt(0)
  name: string @required
  sku: string
  barcode: string
  cost_price: float64
  sale_price: float64
  stock_quantity: float64
  attributes: string
  is_active: bool
}

message CreateVariantResponse {
  variant_id: int64
  message: string
}

message DeleteVariantRequest {
  id: int64 @required @gt(0)
}

message DeleteVariantResponse {
  message: string
}

message ListVariantsRequest {
  product_id: int64 @query("product_id")
}

message ListVariantsResponse {
  variants: Variant[]
}

message UpdateVariantBody {
  product_id: int64
  name: string @required
  sku: string
  barcode: string
  cost_price: float64
  sale_price: float64
  stock_quantity: float64
  attributes: string
  is_active: bool
}

message UpdateVariantRequest {
  id: int64 @required @gt(0)
  body: UpdateVariantBody
}

message UpdateVariantResponse {
  message: string
}
