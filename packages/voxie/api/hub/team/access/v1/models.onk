package hub.team.access.v1

message AccessRequest {
  id: int64
  /// Identifies the user who requested access.
  user_id: int64
  app: string
  requester_name: string
  requester_email: string
  /// When the record was created.
  created_at: string
}

message RequestAccessRequest {
  app: string @required
}

message RequestAccessResponse {
  message: string
}

message ListAccessRequestsRequest {}

message ListAccessRequestsResponse {
  requests: AccessRequest[]
}

message ApproveAccessRequestRequest {
  id: int64 @required @gt(0)
  /// Identifies the user being granted access.
  user_id: int64 @required @gt(0)
  app: string @required
}

message ApproveAccessRequestResponse {
  message: string
}
