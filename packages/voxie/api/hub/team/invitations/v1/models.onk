package hub.team.invitations.v1

message InviteUserRequest {
  email: string @required @email
  full_name: string @required
  role: string @required
  apps: string[] @min_items(1)
  /// Optional password when an administrator creates the account directly.
  /// Email invitations leave this empty so the recipient chooses a password
  /// while accepting the invite.
  password: string
}

message InviteUserResponse {
  user_id: int64
  message: string
}

message BulkInviteRequest {
  emails: string[] @min_items(1)
  role: string
  apps: string[]
  /// Identifies an optional group to add invitees to.
  group_id: int64
}

message BulkInviteResult {
  email: string
  user_id: int64
  status: string
  message: string
}

message BulkInviteResponse {
  /// Per-email invite outcome list.
  results: BulkInviteResult[]
  message: string
}

message VerifyInviteRequest {
  /// Opaque token used to complete the operation.
  token: string @required
}

message VerifyInviteResponse {
  email: string
  full_name: string
  valid: bool
  /// Lists the app IDs the invited user will have access to, so the
  /// frontend can redirect to the right app after the invite is accepted.
  apps: string[]
}

message AcceptInviteRequest {
  /// Opaque token used to complete the operation.
  token: string @required
  /// User-provided secret for authentication.
  password: string @required
}

message AcceptInviteResponse {
  message: string
}
