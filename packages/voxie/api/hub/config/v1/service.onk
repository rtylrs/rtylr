package hub.config.v1

/// ConfigService defines hub configuration endpoints.
service ConfigService {
  /// Returns the active business configuration.
  getConfig(GetConfigRequest) -> GetConfigResponse @get("/config")

  /// Creates the business configuration.
  createConfig(CreateConfigRequest) -> CreateConfigResponse @post("/config")

  /// Updates the business configuration.
  updateConfig(UpdateConfigRequest) -> UpdateConfigResponse @put("/config")

  /// Returns the industry catalog grouped by category.
  getIndustries(GetIndustriesRequest) -> GetIndustriesResponse @get("/industries")
}
