package support.customer.v1

message Customer {
  id: int64
  business_id: int64
  name: string
  email: string
  phone: string
  total_tickets: int32
  last_ticket_at: string
  created_at: string
}

message ListCustomersRequest {
  page: int32 @query("page")
  page_size: int32 @query("page_size")
}

message ListCustomersResponse {
  customers: Customer[]
  total: int32
  page: int32
  page_size: int32
}

message GetCustomerRequest {
  id: int64 @required @gt(0)
}

message GetCustomerResponse {
  customer: Customer
}
