package flow.view.v1

message View {
  id: int64
  name: string
  icon: string
  /// JSON-encoded filter criteria for this saved view.
  filters: string
  group_by: string
  sort_by: string
  sort_dir: string
}

message ListViewsRequest {
  workspace_id: string @query("workspace_id")
}

message ListViewsResponse {
  views: View[]
}

message CreateViewRequest {
  workspace_id: string
  name: string @required
  icon: string
  /// JSON-encoded filter criteria for this saved view.
  filters: string
  group_by: string
  sort_by: string
  sort_dir: string
}

message CreateViewResponse {
  view: View
}

message UpdateViewRequest {
  id: int64
  name: string
  icon: string
  /// JSON-encoded filter criteria for this saved view.
  filters: string
  group_by: string
  sort_by: string
  sort_dir: string
}

message UpdateViewResponse {}

message DeleteViewRequest {
  id: int64
}

message DeleteViewResponse {}
