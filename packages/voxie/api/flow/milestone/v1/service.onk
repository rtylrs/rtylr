package flow.milestone.v1

service MilestoneService {
  listMilestones(ListMilestonesRequest) -> ListMilestonesResponse @get("/milestones")

  createMilestone(CreateMilestoneRequest) -> CreateMilestoneResponse @post("/milestones")

  updateMilestone(UpdateMilestoneRequest) -> UpdateMilestoneResponse @put("/milestones/{id}")
}
