package hr.benefit.v1

message BenefitPlan {
  id: int64
  owner_id: int64
  name: string
  type: string
  provider: string
  cost_employer: float64
  cost_employee: float64
  is_active: bool
  created_at: string
}

message CreateBenefitRequest {
  name: string @required
  type: string
  provider: string
  cost_employer: float64
  cost_employee: float64
  is_active: bool
}

message CreateBenefitResponse {
  id: int64
  message: string
}

message ListBenefitsRequest {}

message ListBenefitsResponse {
  plans: BenefitPlan[]
}
