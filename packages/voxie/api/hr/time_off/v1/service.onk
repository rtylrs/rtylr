package hr.time_off.v1

/// TimeOffService defines HR time-off endpoints.
service TimeOffService {
  /// Returns time-off records.
  listTimeOff(ListTimeOffRequest) -> ListTimeOffResponse @get("/requests")

  /// Submits a time-off request.
  submitTimeOff(SubmitTimeOffRequest) -> SubmitTimeOffResponse @post("/requests")
}
