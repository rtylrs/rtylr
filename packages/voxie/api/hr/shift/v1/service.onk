package hr.shift.v1

/// ShiftService defines HR shift and roster endpoints.
service ShiftService {
  /// Returns shifts with optional filters.
  listShifts(ListShiftsRequest) -> ListShiftsResponse @get("/shifts")

  /// Creates a new shift.
  createShift(CreateShiftRequest) -> CreateShiftResponse @post("/shifts")

  /// Assigns an employee to a shift.
  createShiftAssignment(CreateShiftAssignmentRequest) -> CreateShiftAssignmentResponse @post("/assignments")

  /// Returns the shift roster for a location and week.
  getRoster(GetRosterRequest) -> GetRosterResponse @get("/roster/{location_id}")

  /// Publishes the roster for a week.
  publishRoster(PublishRosterRequest) -> PublishRosterResponse @post("/roster/publish")
}
