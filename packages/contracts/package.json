{
  "name": "@voxire/contracts",
  "version": "0.0.1",
  "description": "Generated TypeScript types from voxie protobuf contracts",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
