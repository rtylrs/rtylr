    "./hr/*": "./src/hr/*.ts",
    "./crm/*": "./src/crm/*.ts",
    "./finance/*": "./src/finance/*.ts",
    "./flow/*": "./src/flow/*.ts",
    "./store/*": "./src/store/*.ts",
    "./book/*": "./src/book/*.ts",
