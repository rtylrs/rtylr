{
  "name": "@voxire/contracts",
  "version": "0.0.1",
  "description": "Generated TypeScript types from voxie protobuf contracts",
  "type": "module",
  "exports": {
    "./validation/metadata": "./src/validation/metadata.ts",
    "./validation/metadata.json": "./src/validation/metadata.json",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "devDependencies": {
    "ts-proto": "^2.11.6",
    "typescript": "~6.0.3"
  }
}
