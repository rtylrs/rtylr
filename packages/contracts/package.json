{
  "name": "@voxire/contracts",
  "version": "0.0.1",
  "description": "TypeScript contracts re-exported from the voxie submodule's generated gen/ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./validation/metadata": "./voxie/gen/ts/validation/metadata.ts",
    "./validation/metadata.json": "./voxie/gen/ts/validation/metadata.json",
    "./*": "./voxie/gen/ts/*.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./voxie/gen/ts/*"
      ]
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
