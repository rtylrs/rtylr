{
  "name": "@rtylr/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "MCP server for rtylr \u2014 gives AI agents access to Flow, CRM, Finance, ERP and POS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "rtylr-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.20.0",
    "open": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtylrs/rtylr.git",
    "directory": "clients/mcp"
  },
  "homepage": "https://docs.rtylr.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rtylr",
    "ai",
    "claude",
    "business",
    "crm",
    "erp",
    "finance"
  ]
}
