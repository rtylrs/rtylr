{
  "name": "@voxire/voxie",
  "version": "0.0.1",
  "private": true,
  "description": "Generated TypeScript contracts and clients from Voxie's onekit .onk definitions",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./validation/metadata": "./src/validation/metadata.ts",
    "./validation/metadata.json": "./src/validation/metadata.json",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
