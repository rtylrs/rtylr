{
  "name": "@rtylr/portal",
  "version": "0.0.0",
  "description": "RTYLR Portal, SSO and public menu/careers entrypoints",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:auth": "vite --config entrypoints/auth/vite.config.mts",
    "dev:recruit": "vite --config entrypoints/recruit/vite.config.ts",
    "build": "./scripts/ensure-contracts.sh && pnpm typecheck:all && pnpm build:portal && pnpm build:auth && pnpm build:recruit",
    "build:portal": "vite build",
    "build:auth": "vite build --config entrypoints/auth/vite.config.mts",
    "build:recruit": "vite build --config entrypoints/recruit/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p entrypoints/auth/tsconfig.app.json && tsc --noEmit -p entrypoints/recruit/tsconfig.json",
    "typecheck:all": "./scripts/ensure-contracts.sh && pnpm -C .. -r --filter @voxire/* --filter @rtylr/mcp --filter rtylr-pos typecheck && pnpm typecheck",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p entrypoints/auth/tsconfig.test.json",
    "preview": "vite preview",
    "test": "./scripts/test-with-file-check.sh",
    "test:watch": "./scripts/vitest.sh",
    "test:coverage": "./scripts/vitest.sh run --coverage",
    "test:e2e": "playwright test",
    "test:screenshots": "playwright test --grep @screenshots",
    "contracts:audit-requests": "./scripts/ensure-contracts.sh && node scripts/audit-request-contracts.mjs --fail-on-errors",
    "contracts:enforce": "node scripts/enforce-onekit-boundary.mjs --changed-only",
    "contracts:enforce:all": "node scripts/enforce-onekit-boundary.mjs --all",
    "test:authorization-evidence": "node scripts/validate-authorization-evidence.mjs",
    "contracts:sync": "./scripts/ensure-contracts.sh && pnpm -C .. --filter @voxire/voxie typecheck",
    "docs:verify-citations": "node scripts/cross-app/verify-citations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -C .. lint",
    "init": "make -C ../../voxie generate"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-router": "^1.170.8",
    "@voxire/api": "workspace:*",
    "@voxire/auth": "workspace:*",
    "@voxire/caret": "workspace:*",
    "@voxire/config": "workspace:*",
    "@voxire/consent": "workspace:*",
    "@voxire/i18n": "workspace:*",
    "@voxire/menu": "workspace:*",
    "@voxire/observability": "workspace:*",
    "@voxire/permissions": "workspace:*",
    "@voxire/types": "workspace:*",
    "@voxire/ui": "workspace:*",
    "@voxire/utils": "workspace:*",
    "@voxire/voxie": "workspace:*",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.6",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-cookie": "^8.1.0",
    "react-dom": "^19.2.5",
    "react-dropzone": "^15.0.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.4",
    "react-lazy-load-image-component": "^1.6.3",
    "react-qrcode-logo": "^4.0.0",
    "shepherd.js": "^15.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-virtual": "^3.13.24",
    "zod": "^4.6.7",
    "@voxire/components": "workspace:*",
    "neverthrow": "8.2.0",
    "react-icons": "^5.6.0",
    "react-loading-skeleton": "^3.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jiti": "2.6.1",
    "jsdom": "~29.0.2",
    "sass": "^1.99.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.12",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.9.0",
    "i18next-resources-to-backend": "^1.2.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "vite-tsconfig-paths": "^6.1.1",
    "postcss": "8.5.23"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
